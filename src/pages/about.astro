---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { experience } from '../data/experience';
---
<Base title="About" description="Drew Cleaver's background in founder operations, e-commerce, enterprise sales, and technical manufacturing. Explore his experience or download his résumé.">
  <div class="shell">
    <section class="page-heading">
      <p class="eyebrow">A little background</p>
      <h1 class="serif">Founder, operator,<br /><em>curious person.</em></h1>
      <div class="prose about-intro">
        <p>I'm Drew Cleaver, based in Austin, Texas. My work has taken me from technical sales in oil and gas to co-founding and operating Higher Hangers.</p>
        <p>I've built new markets, worked with technical buyers, and turned a patented physical product into a business serving customers around the world. Along the way, I've learned how much good execution depends on both the systems you build and the relationships you earn.</p>
        <p>That experience shapes my advisory work today: helping people think through business decisions, make sense of their options, and put useful ideas to work.</p>
      </div>
      <div class="actions">
        <a class="button" href={profile.resumeFile} download="Drew-Cleaver-Resume.pdf">Download my résumé (PDF) <span aria-hidden="true">↓</span></a>
        <a class="text-link" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="experience-section" aria-labelledby="experience-title">
      <div class="section-heading"><h2 id="experience-title" class="serif">Experience</h2></div>
      <ol class="experience-list">
        {experience.map(({ role, specialty, org, period, location, highlights }) => (
          <li class="experience-entry">
            <div class="experience-meta">
              <p>{period}</p>
              <p>{location}</p>
            </div>
            <div>
              <h3 class="serif">{role}</h3>
              <p class="experience-org">{org}</p>
              <p class="experience-specialty">{specialty}</p>
              <ul class="experience-highlights">
                {highlights.map(highlight => <li>{highlight}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="experience-section education-section" aria-labelledby="education-title">
      <div class="section-heading"><h2 id="education-title" class="serif">Education</h2></div>
      <h3 class="serif">Bachelor of Science, Business Management</h3>
      <p class="experience-org">John Brown University</p>
      <p class="experience-specialty">Siloam Springs, Arkansas</p>
      <ul class="experience-highlights">
        <li>Completed the degree in six semesters while working 20–60 hours per week; served as Club Baseball President.</li>
        <li>Grand Prize Winner of the $40,000 D.W. Reynolds Business Plan Competition with Higher Hangers.</li>
      </ul>
    </section>

    <section class="open-door" aria-labelledby="about-contact-title">
      <h2 id="about-contact-title" class="serif">Want to talk?</h2>
      <p>A question, a collaboration, or a business decision you're working through—you're welcome to reach out.</p>
      <div class="actions">
        <a class="button" href="/contact/">Send an inquiry <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={profile.bookingUrl}>Schedule a conversation <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</Base>
