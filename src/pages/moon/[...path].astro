---
import {
  routes,
  root,
  paths,
  families,
  hardware,
  blank,
  cableUrl,
  productUrl,
  utopia,
} from '../../moon/catalog.mjs'
import {
  landing,
  cablePage,
  productPage,
  deskGuide,
  roomGuide,
} from '../../moon/shop.mjs'
import { presenter, cartView, advisorView } from '../../moon/service.mjs'
import '../../moon/workshop.css'

export function getStaticPaths() {
  return routes.map((route) => ({
    params: { path: route || undefined },
    props: { route },
  }))
}
const { route } = Astro.props
const [group, key] = route.split('/')
const title =
  group === 'cables'
    ? families[key].name
    : group === 'products'
      ? hardware[key].name
      : {
          '': 'The cable workshop',
          'guides/desk': 'A first premium MacBook desk',
          'guides/home': 'Listening at home',
          cart: 'Your workshop bag',
          review: 'Guest order review',
          quote: 'Your checked quote',
          fit: 'Audio Concierge',
          presenter: 'Workshop controls',
          advisor: 'The cable desk',
        }[route] || 'The cable workshop'
const opening =
  '<div class="wrap single"><p class="eyebrow">Cary cable desk</p><h1>Opening your <em>build card.</em></h1></div>'
const html =
  group === 'cables'
    ? cablePage(blank(key))
    : group === 'products'
      ? productPage(key)
      : route === 'guides/desk'
        ? deskGuide()
        : route === 'guides/home'
          ? roomGuide()
          : route === 'presenter'
            ? presenter(true, null)
            : route === 'advisor'
              ? advisorView(null, '')
              : route === 'cart' || route === 'review'
                ? cartView([], route === 'review')
                : route === ''
                  ? landing()
                  : opening
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f8f6f0" />
    <script is:inline>
      if (
        location.hash.startsWith('#w') ||
        new URLSearchParams(location.search).has('fit') ||
        new URLSearchParams(location.search).has('edit') ||
        /\/(cart|review)\/?$/.test(location.pathname)
      )
        document.documentElement.dataset.restoring = 'true'
    </script>
    <meta
      name="description"
      content="An independent Moon Audio cable workshop concept by Drew Cleaver. Explore a fitted Dragon Cable and a local demo checkout."
    />
    <link
      rel="canonical"
      href={new URL(Astro.url.pathname, 'https://drewcleaver.com')}
    />
    <link
      rel="preload"
      href="/moon/type/newsreader-roman.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="icon" href="/moon/art/workshop-mark.svg" type="image/svg+xml" />
    <title>{title} | Moon Audio Workshop</title>
  </head>
  <body>
    <a class="skip" href="#content">
      Skip to content
    </a>
    <div class="demo-label">
      Independent concept by Drew Cleaver <span aria-hidden="true">·</span> Demo
      checkout
    </div>
    <header class="masthead">
      <div class="wrap mast-inner">
        <a class="brand" href={root} aria-label="Moon Audio workshop home">
          <svg width="38" height="38" viewBox="0 0 44 44" aria-hidden="true">
            <circle
              cx="22"
              cy="22"
              r="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            />
            <path
              d="M27.6 6.5a16.6 16.6 0 1 0 8.7 24.2c-5.8 3.5-13.5 1.3-16.9-4.9-3.9-7.2-.8-15.6 8.2-19.3Z"
              fill="currentColor"
            />
            <path
              d="M30 11a13 13 0 0 1 5 11m-8-8a9 9 0 0 1 3.5 7.2"
              stroke="currentColor"
              stroke-width="1.2"
              fill="none"
            />
          </svg>
          <span>
            MOON<span class="brand-light">AUDIO</span>
          </span>
        </a>
        <nav class="desktop" aria-label="Workshop navigation">
          <a href={cableUrl('blue')}>Dragon cables</a>
          <a href={productUrl(utopia)}>Headphones</a>
          <a href={paths.desk}>Listening guides</a>
          <a data-help href={paths.fit}>
            Audio Concierge
          </a>
        </nav>
        <div class="mast-actions">
          <a class="bag-link" href={paths.cart}>
            <svg
              width="19"
              height="21"
              viewBox="0 0 22 24"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path d="M3 7h16l1 15H2L3 7Z" />
              <path d="M7 9V6a4 4 0 0 1 8 0v3" />
            </svg>
            <span>
              Bag <span data-bag-count>0</span>
            </span>
          </a>
          <details class="navmenu">
            <summary aria-label="Workshop menu">
              <svg
                width="22"
                height="17"
                viewBox="0 0 22 17"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              >
                <path d="M1 3h20M1 9h20M7 15h14" />
              </svg>
            </summary>
            <nav aria-label="All workshop routes">
              <a href={root}>Find by gear model</a>
              <a data-expert href={cableUrl('blue') + '?mode=expert'}>
                I know my connectors
              </a>
              <a href={productUrl(utopia)}>Focal Utopia 2022</a>
              <a href={paths.desk}>Build a MacBook desk setup</a>
              <a href={paths.home}>Find headphones for listening at home</a>
              <a data-help href={paths.fit}>
                Audio Concierge
              </a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <noscript>
      <p class="wrap notice">
        Enable JavaScript to configure a cable, save a bag or open a checked
        quote.
      </p>
    </noscript>
    <main id="content" tabindex="-1" data-route={route} set:html={html} />
    <footer>
      <div class="wrap footer-inner">
        <div>
          <span class="footer-name">
            Moon Audio <em>Workshop</em>
          </span>
          <p>Independent concept by Drew Cleaver · Demo checkout</p>
        </div>
        <nav aria-label="Workshop footer">
          <a href={root}>Shop by model</a>
          <a data-expert href={cableUrl('blue') + '?mode=expert'}>
            I know my connectors
          </a>
          <a data-help href={paths.fit}>
            Audio Concierge
          </a>
        </nav>
      </div>
      <div class="wrap footer-fine">
        Example U.S. merchandise prices · November 4, 2026
      </div>
    </footer>
    <script>
      import '../../moon/entry.mjs'
    </script>
  </body>
</html>
