---
import { getCollection, type CollectionEntry } from 'astro:content';
import { features } from '../../config/features';
import WritingIndex from '../../features/writing/WritingIndex.astro';
import WritingPost from '../../features/writing/WritingPost.astro';

export async function getStaticPaths() {
  if (!features.writing) return [];
  const posts = (await getCollection('writing', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return [
    { params: { path: undefined }, props: { posts } },
    ...posts.map(post => ({ params: { path: post.id }, props: { post } })),
  ];
}
interface Props {
  post?: CollectionEntry<'writing'>;
  posts?: CollectionEntry<'writing'>[];
}
const { post, posts = [] } = Astro.props;
---
{post ? <WritingPost post={post} /> : <WritingIndex posts={posts} />}
