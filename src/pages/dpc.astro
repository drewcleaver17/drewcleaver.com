const mature=snapshot.mature, launch=snapshot.launch;
const money=(value)=>formatMetric(value,'money'),number=(value)=>formatMetric(value,'number');
const updated=centralTimestamp(revision.updatedAt);
const sources=[
 ['ama','American Medical Association: work beyond appointments','Its 2024 survey discussion distinguishes direct care, indirect care, administration and work outside normal hours. It does not validate this proposed schedule.','https://www.ama-assn.org/practice-management/physician-health/doctors-work-fewer-hours-ehr-still-follows-them-home'],
 ['aafp','AAFP: Direct primary care','Category, physician career options and general pricing context. The overview links to its 2024 data brief. This is not an Austin price survey.','https://www.aafp.org/practice-operations/practice-and-payment-models/direct-primary-care'],
 ['frontier','DPC Frontier: DPC defined','The organization’s definition includes periodic fees and limits on per-visit charges. Category terminology does not determine tax treatment.','https://www.dpcfrontier.com/defined'],
 ['irs','IRS Notice 2026-5','Contribution eligibility and reimbursement from an existing HSA have different rules. See questions 11–13 and 20.','https://www.irs.gov/pub/irs-drop/n-26-05.pdf'],
 ['tma','Texas Medical Association','Corporate practice of medicine background, September 2016. Current ownership and service agreements require legal review.','https://www.texmed.org/CPMwhitepaper/'],
 ['ftc','Federal Trade Commission','Franchise Rule guidance. Counsel should determine whether any eventual arrangement triggers disclosure obligations.','https://www.ftc.gov/business-guidance/resources/franchise-rule-compliance-guide']
];
const costRows=[['Owner physician cash pay',reference.ownerPay],['Two associate physicians',reference.associates*reference.associatePay],['Physician employment costs',mature.physicianBurden],['Local support staff',reference.support],['Occupancy and utilities',reference.occupancy],['Clinical technology and supplies',reference.technology],['Local marketing',reference.marketing],['Other administration and insurance',reference.other],['Shared support fee',reference.platformFee*12]];
const tests=[
 ['Patients value the offering','Paid demand, retained members and reasons for leaving. Review with patients and an experienced DPC operator.','Price, included care and target audience'],
 ['The work fits the schedule','Measure visits, messages, urgent work and coverage. Review with a physician lead.','Panel size, staffing and access promise'],
 ['Physicians want the pathway','Recruiting conversations and draft economic terms. Review with physician owners.','Compensation, ownership and succession'],
 ['Support services justify the fee','Costed delivery trial and an independent-practice comparison. Review with practice operators.','Platform scope and fee'],
 ['The opening plan can be funded','Startup quotes, enrollment scenarios and financing terms. Review with finance and healthcare counsel.','Funded pilot, then expansion']
];
---
<Base title="Direct Primary Care: A Physician-Owned Growth Model" description="An independent operating-model proposal by Drew Cleaver, with an editable practice, launch and network worksheet for expert review." compact noindex>
 <article class="dpc-page" aria-labelledby="dpc-title">
  <header class="dpc-hero"><div class="dpc-shell">
   <p class="eyebrow">Independent concept by Drew Cleaver <span>Page revision {revision.pageRevision}</span></p>
   <p class="revision-stamp">Updated {updated}. <a href="#revision-history">Revision history</a></p>
   <h1 id="dpc-title">Direct Primary Care:<br /><span>A Physician-Owned<br />Growth Model</span></h1>
   <p class="hero-intro">Small practices with protected clinical time, a path to physician ownership, and shared nonclinical support. A working proposal for physicians, operators, advisors and potential investors to challenge and improve.</p>
   <div class="hero-actions"><a class="button paper" href="#concept">Read the concept ↓</a><a class="button" href="#model">Open the working model ↓</a><a class="button" href="/dpc-deck.pdf?v=R05" download="Direct-Primary-Care-Growth-Model.pdf">Download the 18-slide PDF ↓</a></div>
   <p class="disclosure">Independent and unaffiliated. No practice endorsement, operating results or committed participants are implied. Founder roles, ownership, compensation and partnerships remain undecided. This is an unlisted public page for expert review, not an investment offering.</p>
  </div></header>
  <nav class="section-nav dpc-shell" aria-label="On this page"><a href="#economics">Practice economics</a><a href="#launch">Opening and cash</a><a href="#ownership">Ownership</a><a href="#platform">Shared support</a><a href="#validation">Validation</a><a href="#model">Working model</a><a href="#save-model">Save and share feedback</a></nav>
  <div class="concept-reading">
   <section id="concept"><div class="reading-shell">
    <p class="eyebrow">01 / The proposition</p><h2>A sustainable local practice is the foundation of the growth case.</h2>
    <p>The proposal starts with a familiar physician, dependable access and enough time to follow through. A small practice would pair a physician owner with up to two associates. Shared nonclinical services would handle work that practices can sensibly standardize, while physicians retain clinical judgment and responsibility for care.</p>
    <p>The growth hypothesis is that physicians could learn the operating model, demonstrate readiness and eventually own a practice. The support company would need to make that transition easier and provide continuing value worth its fee.</p>
    <div class="takeaway"><p><strong>Two economic tests must pass:</strong> patients and physicians must value the local practice, and practices must value the shared support enough to sustain its delivery costs. Neither result is established yet.</p></div>
   </div></section>
   <section id="category"><div class="reading-shell">
    <p class="eyebrow">02 / Established category, proposed variation</p><h2>The premium price needs its own patient-value case.</h2>
    <p>DPC is an established model that charges periodic fees for primary care, generally outside traditional insurance billing. Physicians can be employees or owners. <a href="#source-aafp">AAFP category context</a></p>
    <div class="table-region" tabindex="0" role="region" aria-label="Category comparison"><table class="responsive-table"><caption>Category context and hypotheses to test</caption><thead><tr><th>Established DPC context</th><th>This proposal</th></tr></thead><tbody>
     <tr><th scope="row">Recurring membership</th><td data-label="This proposal">Core $200 / Extended $300 per month</td></tr>
     <tr><th scope="row">Ongoing primary care access</th><td data-label="This proposal">Planned relationship visits and protected follow-up time</td></tr>
     <tr><th scope="row">Different practice ownership arrangements</th><td data-label="This proposal">One physician owner, up to two associates, and a potential ownership pathway</td></tr>
     <tr><th scope="row">Different operating arrangements</th><td data-label="This proposal">A shared support company with a defined service fee</td></tr>
    </tbody></table></div>
    <p>AAFP’s overview describes a general $50–$100 monthly range. The proposed $200–$300 sits above that context and needs evidence of willingness to pay. This comparison is not a local market survey or proof that the service packages are equivalent. <a href="#source-aafp">Source</a></p>
    <p>The monthly check-in and paid-extra-visit structure remain design questions. Review them against broader access memberships before fixing the offer. No part of this combination is claimed as a unique invention.</p>
   </div></section>
   <section class="green-band" id="experience"><div class="reading-shell">
    <p class="eyebrow">03 / Proposed organization and care</p><h2>Two staggered associate schedules extend access across the week.</h2>
    <p>Associate A works Sunday–Thursday. Associate B works Tuesday–Saturday. Each has a proposed availability window of <strong>9 a.m.–9 p.m.</strong> and a ceiling of <strong>12 patient encounters per working day</strong>. The owner has a separate schedule and ceiling. These are adjustable design choices, not measured workloads or clinical requirements.</p>
    <div class="table-region" tabindex="0" role="region" aria-label="Proposed weekly roster"><table class="responsive-table"><caption>Typical staffed week, before leave. Owner days are illustrative.</caption><thead><tr><th>Days</th><th>Scheduled physicians</th></tr></thead><tbody><tr><th>Sunday</th><td>Associate A</td></tr><tr><th>Monday</th><td>Associate A + owner</td></tr><tr><th>Tuesday</th><td>Associates A + B</td></tr><tr><th>Wednesday</th><td>Associates A + B + owner</td></tr><tr><th>Thursday</th><td>Associates A + B</td></tr><tr><th>Friday</th><td>Associate B + owner</td></tr><tr><th>Saturday</th><td>Associate B</td></tr></tbody></table></div>
    <p>This is ten associate workdays spread across seven calendar days. The 46-week reference leaves six weeks per physician without scheduled relief. Sunday loses its sole scheduled physician if Associate A is away; Saturday does if Associate B is away. Coverage costs and an actual absence plan are still required.</p>
    <h3>The appointment window is narrower than the availability window.</h3>
    <p>The illustrative routine cutoff is <strong>6 p.m.</strong> Appointments must finish by then. A nine-hour booking window, with one hour each for breaks, messages/follow-up and urgent reserve, leaves six hours for routine appointments. That fits six one-hour bookings, or about 6.86 visits at the reference mix of 30- and 60-minute blocks.</p>
    <p>The late window supports a defined response and triage service. It does not open every late hour for routine appointments, imply twelve hours onsite, or provide emergency-department coverage. Onsite versus remote expectations and escalation to the owner remain to be agreed. An associate can be the first contact while owner escalation still consumes time and needs coverage on the owner's off days.</p>
    <p>The 12 ceiling includes onboarding, urgent and visit-equivalent virtual encounters. Messages consume work time separately. Twelve one-hour bookings plus breaks and follow-up exceed the twelve-hour window. <a href="#source-ama">AMA context on work beyond appointments</a> supports measuring the full workload; it does not endorse this roster.</p>
    <p class="note">Core uses 25 physician minutes in a 30-minute block; Extended uses 45 minutes in a 60-minute block. Per-role block multipliers are editable. The model assumes patients can use pooled team capacity; patient continuity, complexity and response quality require clinical review. Membership does not replace hospital or specialist coverage.</p>
   </div></section>
   <section id="economics"><div class="reading-shell">
    <p class="eyebrow">04 / Mature economics under the revised basis</p><h2>The proposed roster still needs a better price, cost or capacity combination.</h2>
    <dl class="key-figures"><div><dt>Members within the access target</dt><dd>{mature.safeMembers}</dd></div><div><dt>Annual revenue at that enrollment</dt><dd>{money(mature.revenue)}</dd></div><div><dt>Result before added coverage costs</dt><dd>{money(mature.surplusBeforeCoverage)}</dd></div></dl>
    <p>The revised reference has {number(mature.routineCapacity)} routine slots per month before onboarding and additional demands. Daily constraints reduce supportable enrollment to {mature.safeMembers} at the selected 85% access target. That uses 70% monthly routine attendance, one extra hour to onboard each replacement member, 1% monthly attrition, and an illustrative demand pattern giving each weekday twice the weight of each weekend day.</p>
    <p><strong>This is an arithmetic planning limit, not a clinically validated panel.</strong> At the reference $275 blended monthly dues, constrained enrollment generates {money(mature.revenue)}. The existing cost assumptions total {money(mature.enteredBaseCost)} before four additional coverage categories. Final profit and complete funding requirements stay incomplete until those costs are supplied.</p>
    <section class="concept-detail"><h3>The cost basis remains visible</h3><dl class="cost-list">{costRows.map(([label,value])=><div><dt>{label}</dt><dd>{money(value)}</dd></div>)}<div class="total"><dt>Entered annual cost before coverage increments</dt><dd>{money(mature.enteredBaseCost)}</dd></div><div><dt>Additional evening/weekend support</dt><dd>Unknown</dd></div><div><dt>Additional leave relief</dt><dd>Unknown</dd></div><div><dt>Recurring recruiting and development</dt><dd>Unknown</dd></div><div><dt>Additional extended-hours operations</dt><dd>Unknown</dd></div></dl><p class="note">These are illustrative figures, not payroll disclosures or quotes. Enter zero only when an increment is genuinely absent or already included. Relief expense alone does not create appointment capacity; add its roster too. Compensation is independent of working hours.</p></section>
    <h3>Changes in the offer change the result.</h3>
    <div class="table-region"><table class="responsive-table"><caption>One-change sensitivities; all other reference inputs held fixed</caption><thead><tr><th>Scheduling hypothesis</th><th>Members within target</th></tr></thead><tbody><tr><th>Revised reference, 6 p.m. routine cutoff</th><td>{mature.safeMembers}</td></tr><tr><th>Associates finish routine bookings at 7 p.m.</th><td>{snapshot.sensitivities.laterCutoff.mature.safeMembers}</td></tr><tr><th>Both routine blocks become 30 minutes, with 25 physician minutes</th><td>{snapshot.sensitivities.shorterBlocks.mature.safeMembers}</td></tr><tr><th>Equal patient demand every day</th><td>{snapshot.sensitivities.equalWeekdayDemand.mature.safeMembers}</td></tr></tbody></table></div>
    <p>Shorter blocks alter the offering and require clinical review. At unchanged 360-member enrollment, revenue remains $1,188,000 and the former $78,000 surplus remains only before the new coverage costs. That stress case exceeds the revised daily access target. More availability alone creates neither members nor membership revenue.</p>
    <p>With all four coverage increments set to zero, 337 members would still be needed for break-even and 396 for a 15% operating margin at the current prices. Both exceed the revised reference limit. Annual-payment discounts can reduce earned margin further; early cash receipts do not remove that cost.</p>
   </div></section>
   <section id="launch"><div class="reading-shell">
    <p class="eyebrow">05 / Enrollment and cash</p><h2>The opening plan must fund a constrained enrollment ramp.</h2>
    <p>The 36-month illustration opens care in month 2, with the owner starting then, Associate A in month 5 and Associate B in month 11. Thirty people seek to join at opening and 25 more per month afterward. These are demand hypotheses. Enrollment accounts for 1% monthly attrition, onboarding work, day-specific capacity and the selected access buffer.</p>
    <p>The model admits approximately {number(launch.rows[1].newMembers)} expected members at opening rather than automatically admitting all 30. Before full staffing, the reference offers care on staffed days and redistributes demand to them. Patient willingness to accept that limited launch offer is unproven. Selecting seven-day access from opening can postpone admissions until the roster supports it.</p>
    <p>Unadmitted applicants do not generate revenue. The waitlist assumes no abandonment and is not traction. If a leadership stage or departure leaves existing members beyond physical capacity, the constrained revenue and cash projections become incomplete. The model does not invent patient transfers or drop their care obligations.</p>
    <div class="takeaway"><p><strong>The complete funding need is unknown.</strong> As a diagnostic only, setting the four additional coverage costs to zero produces a cumulative 36-month operating result of {money(snapshot.zeroCoverage.launch.totalOperatingResult)}, before startup spending or financing. Sustained monthly break-even is not reached in that lower-cost sensitivity.</p></div>
    <p>Enter equipment, deposits, setup costs, opening cash, funding and a target reserve to complete the cash view. Startup spending occurs once. Opening cash and financing are funding sources. A reserve is a desired cash balance, not a second expense.</p>
    <p>Annual members pay at joining and each renewal. Revenue is earned monthly, while modeled cancellations refund unused prepaid months. Unearned dues remain an obligation. Operating break-even, cumulative operating-loss recovery and startup investment cash recovery are separate results.</p>
    <p class="note">Monthly aggregation does not establish daily liquidity. No debt amortization, tax model, investment return or new-location revenue is inferred. The stress option explicitly shows unconstrained enrollment; it is not a feasible forecast when the capacity checks fail.</p>
   </div></section>
   <section class="green-band" id="ownership"><div class="reading-shell">
    <p class="eyebrow">06 / Development, leadership and succession</p><h2>Leadership time needs a funded reduction in clinical work.</h2>
    <ol class="ownership-steps"><li><strong>Build a practice.</strong> Associates develop patient relationships, clinical cadence and operating judgment while contributing to enrollment and retention.</li><li><strong>Take on leadership.</strong> Agree on management, mentoring and general-manager responsibilities. Reduce clinical days or bookable hours explicitly as those duties grow.</li><li><strong>Prepare a successor.</strong> Budget recruiting and overlapping pay. Protect the trainer's time and give a replacement an explicit initial schedule.</li><li><strong>Evaluate ownership.</strong> Review sustained economics, continuity, clinical judgment, leadership readiness, financing and governance before a buy-in or new location.</li></ol>
    <p>For illustration, adding two management hours per working day for Associate A in month 24, with unchanged salary, lowers the mature snapshot's enrollment limit from {mature.safeMembers} to {snapshot.sensitivities.leadership.mature.safeMembers}. This optional stage is not built into the default reference. The worksheet lets each physician have their own stage dates, days, blocks, responsibilities and pay.</p>
    <p>A break-even contribution alone does not establish readiness. Longer availability does not by itself prove faster clinical development. A replacement can temporarily take staffing above the proposed three-physician steady team; the model makes that overlap and its pay visible.</p>
    <p>A departing physician loses capacity at the original location after the final paid month. No automatic patient transfer or simultaneous capacity at two locations is assumed. A second location needs its own demand, startup funding and opening plan.</p>
    <p><strong>Drew developed this concept.</strong> Whether he builds the support company or helps a physician-led founding team remains undecided. Founder roles, ownership percentages, compensation agreements and partnerships remain open.</p>
   </div></section>
   <section id="platform"><div class="reading-shell">
    <p class="eyebrow">07 / Shared support and investment logic</p><h2>The support company must earn its fee through useful work.</h2>
    <p>Proposed services include administrative workflows, scheduling systems, vendor coordination, recruiting support, operating reports and practice-owner development. Practices would retain clinical judgment, responsibility for care quality and patient relationships.</p>
    <p>The reference fee is $5,000 per location per month. Reviewers should compare a costed service package with a realistic independent-practice alternative: what work disappears, what becomes more reliable, and what remains local? The fee is an assumption, not evidence of savings or an approved contract.</p>
    <div class="table-region" tabindex="0" role="region" aria-label="Mature network arithmetic"><table class="responsive-table"><caption>Equally mature practices. This is not a rollout forecast.</caption><thead><tr><th>Locations</th><th>Practice revenue / year</th><th>Platform revenue / year</th></tr></thead><tbody>{[1,25,100].map(n=><tr><th scope="row">{n}</th><td data-label="Practice revenue / year">{money(n*mature.revenue)}</td><td data-label="Platform revenue / year">{money(n*reference.platformFee*12)}</td></tr>)}</tbody></table></div>
    <p>Platform earnings equal fees less delivery costs and central overhead. Those costs remain blank until supplied. Combined practice and platform surplus eliminates the internal fee transfer.</p>
    <p>Physician owners could receive practice distributions after obligations. An investment in the support company would depend on its own earnings, contractual rights and ability to retain practices. The model assumes no exit multiple, investor return or automatic venture-capital fit.</p>
    <p class="note">The legal entity structure, clinical boundaries, fee terms and possible franchise obligations need specialist review. The <a href="#source-tma">TMA background paper</a> and <a href="#source-ftc">FTC guidance</a> identify issues to examine, not approval of this arrangement.</p>
   </div></section>
   <section id="validation"><div class="reading-shell">
    <p class="eyebrow">08 / Validation before expansion</p><h2>The next commitment should follow evidence.</h2>
    <div class="table-region" tabindex="0" role="region" aria-label="Validation plan"><table class="responsive-table"><caption>Focused questions for expert review</caption><thead><tr><th>Hypothesis</th><th>Evidence and reviewer</th><th>Decision informed</th></tr></thead><tbody>{tests.map(([hypothesis,evidence,decision])=><tr><th scope="row">{hypothesis}</th><td data-label="Evidence and reviewer">{evidence}</td><td data-label="Decision informed">{decision}</td></tr>)}</tbody></table></div>
    <p>A proposed pilot observes 25 opt-in members for 90 days each. Starting targets include 90% retention, visits ending in agreed care plans and routine replies within the selected coverage target. The reference response input is 24 business hours; a physician should define the actual service promise. Routine utilization should remain at or below 85% in the planning model.</p>
    <p>The 15% operating margin and six stable months before another location are proposed decision gates. They require validation alongside clinical access and physician recruitment. No pilot, interview, commitment or outcome is claimed.</p>
    <section class="concept-detail"><h3>Pricing and tax treatment need a separate review</h3><p>The IRS distinguishes HSA contribution eligibility from reimbursement using existing HSA funds. In 2026, its contribution exception includes a $150 monthly limit for an individual arrangement, with a $300 limit when more than one individual is covered. The reimbursement definition has no corresponding fee cap, but service and payment conditions still apply. The proposed individual prices and additional-visit terms need review before making any tax-benefit claim. <a href="#source-irs">IRS Notice 2026-5, questions 11–13 and 20</a></p></section>
   </div></section>
  </div>
  <DpcModel />
  <section class="sources-section"><div class="reading-shell"><p class="eyebrow">Sources and revision notes</p><h2>Public facts and working assumptions remain separate.</h2><ol class="sources">{sources.map(([id,label,note,url])=><li id={`source-${id}`}><a href={url} target="_blank" rel="noopener noreferrer">{label} ↗</a><p>{note}</p></li>)}</ol><p>Sources checked September 19, 2026. All amounts are USD. The reference deck and narrative are dated illustrations. Web inputs change the working model, not the PDF.</p><section class="concept-detail"><h3>What changed in R05</h3><p>The associate roster now uses Sunday–Thursday and Tuesday–Saturday, a proposed 9 a.m.–9 p.m. availability boundary and a separate 12-encounter ceiling. An earlier routine cutoff, urgent reserve, onboarding, daily demand, leadership stages and departures now feed enrollment and cash calculations. Added coverage costs remain unknown until supplied.</p><p>Earlier worksheets retain their original calculation rules and all values, custom rows, names and feedback. Start a revised proposal explicitly to keep the earlier worksheet and open the new defaults. The PDF is a fixed R05 reference; your calculator edits do not change it.</p></section><a class="text-download" href="/dpc-deck.pdf?v=R05" download="Direct-Primary-Care-Growth-Model.pdf">Download the dated reference deck</a></div></section>
  <section id="revision-history" class="sources-section"><div class="reading-shell"><p class="eyebrow">Publication record</p><h2>Five published iterations, with a traceable history.</h2><p>Current page revision: <strong>{revision.pageRevision}</strong>. Updated {updated}. This is the fixed content-finalization timestamp for this revision, not the viewer's clock. Central Time uses CDT in daylight time and CST in standard time.</p><p class="note">One revision counts each distinct successful release of this concept's page, calculator or PDF. Multiple commits in a release, failed deployments and unrelated site edits do not count. Earlier names below describe historical versions only and imply no current affiliation.</p><ol class="revision-log">{revision.history.map(entry=><li><h3>{entry.id} / {entry.title}</h3><p><time datetime={entry.date}>{centralTimestamp(entry.date)}</time> — {entry.basis}.</p><p>{entry.summary}</p><a href={entry.url} target="_blank" rel="noopener noreferrer">Release evidence ↗</a></li>)}</ol><p class="note">Page {revision.pageRevision}; calculation model {revision.modelVersion}; saved-file schema {revision.schemaVersion}; PDF {revision.pdfRevision}. These identify different things. Publication success is checked against the release workflow separately from the frozen content timestamp.</p></div></section>
 </article>
</Base>
