---
import '../../styles/global.css';
import { profile } from '../../data/profile';
import { campaign, includeCampaign, isLocalReview } from '../../data/cleaver2028.mjs';
import dpcRevision from '../../data/dpc-revisions.json';
import proofpathRevision from '../../data/proofpath-revisions.json';
export function getStaticPaths() {
  return includeCampaign ? [{ params: { path: undefined } }] : [];
}
const canonical = new URL('/cleaver2028', profile.website).href;
const contact = `mailto:${profile.email}`;
const showLabLinks = campaign.labLinksApproved || isLocalReview;
const revisions = { dpc: dpcRevision.pageRevision, proofpath: proofpathRevision.pageRevision };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173e35" />
    <title>{campaign.title}</title>
    <meta name="description" content={campaign.description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={campaign.title} />
    <meta property="og:description" content={campaign.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/cleaver2028/logo.jpeg', profile.website).href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="768" />
    <meta property="og:image:alt" content="Cleaver 2028 — Reinventing Our Future. A green meat cleaver with blue accents." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/cleaver2028/logo.jpeg', profile.website).href} />
    <meta name="twitter:image:alt" content="Cleaver 2028 — Reinventing Our Future. A green meat cleaver with blue accents." />
    <meta name="twitter:title" content={campaign.title} />
    <meta name="twitter:description" content={campaign.description} />
  </head>
  <body class="campaign-page">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="campaign-header">
      <div class="campaign-shell masthead">
        <a class="wordmark" href="/" aria-label="Drew Cleaver home">Drew Cleaver<span aria-hidden="true">.</span></a>
        <span class="edition">2028 / A possible campaign</span>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <article class="campaign-shell" aria-labelledby="intro-title">
        <section class="campaign-intro">
          <div class="campaign-brand">
            <img src="/cleaver2028/logo.jpeg" width="1536" height="768" alt="Cleaver 2028 — Reinventing Our Future" loading="eager" decoding="async" fetchpriority="high" />
          </div>
          <p class="eyebrow">Inventor. Founder. {profile.location}.</p>
          <h1 id="intro-title">Drew Cleaver<span aria-hidden="true">.</span></h1>
          <p class="ambition">{campaign.status.detail}</p>
          <p class="purpose">{campaign.purpose}</p>
          <div class="actions">
            <a class="button" href={contact}>Start a conversation <span aria-hidden="true">↗</span></a>
            {showLabLinks && <a class="text-link" href="/lab/">Explore the Lab <span aria-hidden="true">↗</span></a>}
          </div>
          <p class="planning-status"><span class="status-marker" aria-hidden="true"></span>{campaign.status.label}</p>
          {campaign.status.stage === 'filed' && <p class="filing-record"><time datetime={campaign.status.filingDate}>{campaign.status.filingDate}</time> · <a href={campaign.status.recordUrl}>Official FEC record</a></p>}
        </section>

        <section class="editorial-section" id="why" aria-labelledby="why-title">
          <div class="section-index"><span>01</span><p>Why I’m pursuing this</p></div>
          <div class="section-body">
            <h2 id="why-title">Start with a problem.<br />Be willing to learn.</h2>
            {campaign.why.map(copy => <p>{copy}</p>)}
            <a class="text-link" href="/about/">More about my background <span aria-hidden="true">↗</span></a>
          </div>
        </section>

        <section class="editorial-section" id="method" aria-labelledby="method-title">
          <div class="section-index"><span>02</span><p>How I would approach policy</p></div>
          <div class="section-body">
            <h2 id="method-title">Make the reasoning visible.</h2>
            <ol class="method-list">
              {campaign.method.map(([title, text], index) => <li><span aria-hidden="true">{index + 1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}
            </ol>
          </div>
        </section>

        <section class="editorial-section" id="work" aria-labelledby="work-title">
          <div class="section-index"><span>03</span><p>Work people can inspect</p></div>
          <div class="section-body">
            <h2 id="work-title">Two ideas. Open questions.</h2>
            <p>{campaign.workIntro}</p>
            <div class="examples">
              {campaign.examples.map(example => <section class="example" aria-labelledby={`${example.revisionSource}-title`}>
                <p class="eyebrow muted">Published concept / {revisions[example.revisionSource]}</p>
                <h3 id={`${example.revisionSource}-title`}>{example.name}</h3>
                <p>{example.copy}</p>
                {showLabLinks && <a class="text-link" href={example.href}>Inspect the proposal <span aria-hidden="true">↗</span></a>}
              </section>)}
            </div>
            <p class="evidence-note">{campaign.workLimit}</p>
          </div>
        </section>

        <section class="editorial-section" id="questions" aria-labelledby="faq-title">
          <div class="section-index"><span>04</span><p>A few useful answers</p></div>
          <div class="section-body">
            <h2 id="faq-title">Before we talk.</h2>
            <dl class="faq">
              <div><dt>What stage is this at?</dt><dd>{campaign.status.faq}</dd></div>
              <div><dt>How does AI support the work?</dt><dd>{campaign.ai}</dd></div>
              <div><dt>What does the Lab contain?</dt><dd>{campaign.labFAQ}</dd></div>
              <div><dt>How can I reach you?</dt><dd>Email <a href={contact}>{profile.email}</a>. It’s my existing direct contact.</dd></div>
            </dl>
          </div>
        </section>
        <section class="contact-close" aria-labelledby="contact-title">
          <p class="eyebrow">An open conversation</p>
          <h2 id="contact-title">What should I look at more closely?</h2>
          <p>{campaign.contact}</p>
          <a class="button button-light" href={contact}>Email Drew <span aria-hidden="true">↗</span></a>
        </section>
      </article>
    </main>
    <footer class="campaign-shell campaign-footer">
      <p>{profile.name} / {profile.location}</p>
      <a href="/hello/">Contact card</a>
      {campaign.disclaimer && <p class="disclaimer">{campaign.disclaimer}</p>}
    </footer>
  </body>
</html>
<style>
  .campaign-page{color:var(--color-ink);background:var(--paper)}
  .campaign-shell{width:min(1060px,calc(100% - 40px));margin-inline:auto}
  .campaign-header{border-bottom:1px solid var(--color-border)}
  .masthead{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:.25rem 1.5rem;padding-block:1rem}
  .wordmark{min-height:44px;display:inline-flex;align-items:center}
  .edition{font-size:.8125rem;color:var(--color-muted)}
  .campaign-intro{padding-block:clamp(2.5rem,6vw,5rem) 2.5rem;max-width:820px}
  h1,h2{font-family:var(--serif);font-weight:400;letter-spacing:-.04em;line-height:1.12}
  .campaign-brand{width:min(100%,560px);margin-bottom:1.75rem;background:#fff;border:1px solid var(--color-border);border-radius:3px;overflow:hidden}
  .campaign-brand img{display:block;width:100%;height:auto}
  h1{font-size:clamp(2.5rem,6vw,3.6rem);margin:.8rem 0 1.25rem}
  h1 span{color:#af6d2e}
  .ambition{font-size:clamp(1.3rem,2.5vw,1.85rem);line-height:1.4;max-width:36ch}
  .purpose{font-size:1.125rem;line-height:1.7;max-width:57ch;margin-top:1.2rem}
  .planning-status{display:flex;align-items:center;gap:.6rem;color:var(--color-muted);font-size:.8125rem;margin-top:1.75rem}
  .status-marker{width:.4rem;height:.4rem;border-radius:50%;background:var(--color-muted);flex-shrink:0}
  .editorial-section{display:grid;gap:1.2rem;border-top:1px solid var(--color-border);padding-block:2.25rem;scroll-margin-top:1.5rem}
  .section-index{color:var(--color-muted);font-size:.8125rem;display:flex;gap:.8rem;align-items:baseline}
  .section-index span{color:#765027;font-variant-numeric:tabular-nums}
  .section-index p{margin:0}
  .section-body{min-width:0;max-width:66ch}
  h2{font-size:clamp(1.85rem,3.5vw,2.65rem);margin:0 0 1.15rem}
  .section-body>p{margin-block:1rem;line-height:1.75}
  h3{font-size:1rem;font-weight:600;line-height:1.5;margin:0 0 .25rem}
  .method-list{list-style:none;padding:0;margin:1.5rem 0 0}
  .method-list li{display:grid;grid-template-columns:1.75rem 1fr;gap:.75rem;padding-block:.8rem;border-top:1px solid var(--color-border)}
  .method-list li>span{color:#765027;font-size:.875rem;padding-top:.1rem}
  .method-list p{margin:0;color:var(--color-muted);line-height:1.65}
  .examples{margin-top:1.5rem;border-top:1px solid var(--color-border)}
  .example{padding-block:1.25rem;border-bottom:1px solid var(--color-border)}
  .example .eyebrow{font-size:.6875rem;margin-bottom:.5rem}
  .example h3{font-family:var(--serif);font-size:1.5rem;font-weight:400;letter-spacing:-.02em}
  .example p{margin-block:.5rem;line-height:1.7}
  .evidence-note{font-size:.9375rem;color:var(--color-muted)}
  .faq{margin:1.5rem 0 0}
  .faq>div{margin-bottom:1.3rem}
  .faq dt{font-weight:600;margin-bottom:.35rem}
  .faq dd{margin:0;line-height:1.7;color:var(--color-muted)}
  .faq a{color:var(--green);overflow-wrap:anywhere}
  .contact-close{background:var(--green);color:var(--paper);padding:clamp(1.5rem,5vw,3rem);margin-block:.5rem 2.5rem}
  .contact-close h2{max-width:24ch;margin-top:.8rem}
  .contact-close p:not(.eyebrow){max-width:58ch;line-height:1.75;margin-bottom:1.5rem}
  .campaign-footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.5rem 1rem;padding-bottom:1.5rem;font-size:.8125rem;color:var(--color-muted)}
  .campaign-footer a{display:inline-flex;align-items:center;min-height:44px}
  .campaign-footer p{align-self:center}
  .disclaimer{width:100%;font-size:1rem;color:var(--color-ink);border:1px solid var(--color-border);padding:1rem}
  @media(min-width:768px){.editorial-section{grid-template-columns:190px 1fr;gap:3rem;padding-block:3rem}.section-index{display:block}.section-index p{margin-top:.5rem;max-width:19ch}}
  @media(max-width:389px){.campaign-shell{width:calc(100% - 32px)}.actions{align-items:stretch;gap:.5rem}.actions .button{width:100%}.contact-close{padding:1.3rem}.edition{font-size:.75rem}}
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;animation:none!important;scroll-behavior:auto!important}}
</style>
