---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
---
<Base title="Start a conversation" description="Send Drew a question, a founder-advisory inquiry, or an idea for working together. Budget is optional; an open-ended message is welcome.">
  <div class="shell">
    <section class="page-heading">
      <p class="eyebrow">Say hello</p>
      <h1 class="serif">What's on<br />your mind?</h1>
      <p class="lead">A business question, an idea, or just an introduction. A few sentences is plenty.</p>
    </section>
    <div class="contact-grid">
      <form class="inquiry-form" action={profile.inquiryEndpoint} method="POST" id="inquiry-form">
        <div class="honeypot" aria-hidden="true"><label for="website-check">Leave this empty</label><input id="website-check" type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></div>
        <input type="hidden" name="_subject" value="New inquiry from drewcleaver.com" />
        <div class="form-pair">
          <div class="field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required maxlength="150" /></div>
          <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" /></div>
        </div>
        <div class="field">
          <label for="reason">What brings you here? <span>Optional</span></label>
          <select id="reason" name="reason">
            <option value="">No category needed</option>
            <option value="advisory">Founder advisory</option>
            <option value="project">Project or AI help</option>
            <option value="opportunity">Collaboration or opportunity</option>
            <option value="other">Something else</option>
          </select>
        </div>
        <div class="field"><label for="message">Your message</label><textarea id="message" name="message" required maxlength="10000" placeholder="What are you thinking about, building, or trying to figure out?"></textarea></div>
        <div class="field">
          <label for="price">An offer or budget <span>Optional</span></label>
          <input id="price" name="price" maxlength="200" aria-describedby="price-help" placeholder="A number, a range, or let's discuss" />
          <p class="field-help" id="price-help">For advisory or project work, pay-what-you-want proposals are welcome. Leave this blank for introductions, opportunities, or if you'd rather discuss it.</p>
        </div>
        <p class="form-status" id="form-status" role="status" aria-live="polite" aria-atomic="true" tabindex="-1" hidden></p>
        <div><button type="submit" class="button" id="send-button">Send my message <span aria-hidden="true">↗</span></button><p class="field-help">An inquiry, not a commitment. No mailing-list signup.</p></div>
        <noscript><p class="field-help">The form opens a confirmation page when submitted. You can also email me directly.</p></noscript>
      </form>
      <aside class="contact-aside">
        <h2 class="serif">A direct line.</h2>
        <p>Prefer email? You can always reach me here.</p>
        <a class="text-link" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a>
        <div style="margin-top: 2rem"><p>Or find a time to talk.</p><a class="text-link" href={profile.bookingUrl}>Schedule a conversation <span aria-hidden="true">↗</span></a></div>
        <div style="margin-top: 2rem"><p>For paid work, we'll agree on scope and price together before starting.</p></div>
      </aside>
    </div>
  </div>
</Base>
<script>
  import { initInquiry } from '../scripts/inquiry.mjs';
  initInquiry(document);
</script>
