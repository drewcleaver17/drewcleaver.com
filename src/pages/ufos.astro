---
import Base from '../layouts/Base.astro';
import UfoEvent from '../components/UfoEvent.astro';
import data from '../data/ufos/timeline.json';
import { profile } from '../data/profile';
import { categories, evidenceDefinitions, eras, filterEvents, formatDate, validateDataset } from '../lib/ufos.mjs';
import '../styles/ufos.css';
const errors = validateDataset(data);
if(errors.length) throw new Error(errors.join('\n'));
const all=filterEvents(data,{context:true});
const story=all.filter(e=>!e.context), context=all.filter(e=>e.context);
const entities=[...new Set(all.flatMap(e=>[...e.people,...e.institutions]))].sort();
const years=[...new Set(all.map(e=>e.date.start.slice(0,4)))].sort();
const primary=all.filter(e=>e.verificationLabel==='Primary source read').length;
const latest=story.at(-1);
const contact=`mailto:${profile.email}?subject=${encodeURIComponent('UFO timeline — source or correction')}&body=${encodeURIComponent('Event link:\n\nProposed correction or source:\n\nSupporting source URL(s) — required for review:\n\nWhat the source establishes (and does not establish):\n')}`;
const receipt=(data.meta as any).publicationReceipt;
---
<Base title="UFOs: A Living Timeline" description="What happened. What became public. What remains unresolved. An evidence-centered chronology of UFO and UAP disclosure, with sources and uncertainty kept visible." compact noindex>
  <div class="ufo-page shell" data-edition={data.meta.edition}>
    <header class="ufo-hero">
      <p class="eyebrow">An open record · An unfinished question</p>
      <h1>UFOs<span>A living timeline.</span></h1>
      <p class="ufo-deck">What happened. What became public.<br/>What remains unresolved.</p>
      <div class="hero-bottom"><p>A source-led history of observations, oversight and disclosure. Read the record without having to agree on an explanation.</p><a class="latest-link" href={`#${latest.id}`} id="jump-latest">Jump to latest <span aria-hidden="true">↓</span></a></div>
      <div class="edition-strip"><span>2017—{data.meta.researchCutoff.slice(0,4)}</span><span>{all.length} curated entries · {primary} with primary records read</span><span>Research checked {formatDate(data.meta.researchCutoff)}</span></div>
    </header>

    <section class="orientation" aria-labelledby="orientation-title">
      <div><p class="eyebrow">Before the timeline</p><h2 id="orientation-title">Unknown is a starting point.<br/>Not an origin.</h2></div>
      <div><p><strong>UFO</strong> means unidentified flying object. <strong>UAP</strong>, now commonly “unidentified anomalous phenomena,” is a broader reporting term. <strong>NHI</strong> means non-human intelligence: here it labels an alleged explanation, not an established discovery.</p><p>A documented hearing, a witness’s account and a sensor recording are different kinds of evidence. So are the date of an encounter and the date we learned about it.</p><a href="#methodology" class="underlined">How to read this record →</a></div>
    </section>
    <nav class="era-map" aria-label="Historical phases">{eras.map(era=><a href={`#era-${era.id}`}><span class="eyebrow">{era.years}</span><strong>{era.label.slice(5)}</strong><span>{era.summary}</span></a>)}</nav>

    <section aria-labelledby="timeline-title" class="timeline-section" id="timeline">
      <div class="timeline-heading"><div><p class="eyebrow">The record, in sequence</p><h2 id="timeline-title">Follow the evidence.</h2></div><a href="#hypotheses" class="underlined">Questions worth testing ↗</a></div>
      <form id="timeline-filters" class="filter-panel" role="search" aria-label="Search and filter timeline" hidden>
        <div class="filter-top"><label class="search-field">Search the record<input name="q" type="search" placeholder="Try Grusch, NASA, archives…" autocomplete="off" /></label><label>View<select name="view"><option value="story">Chronological story</option><option value="recent">Recently added or corrected</option></select></label><label>Order<select name="sort"><option value="oldest">Oldest first</option><option value="newest">Newest first</option></select></label></div>
        <details class="filter-details"><summary>Refine by date, topic & evidence <span aria-hidden="true">+</span></summary><div class="filter-grid"><label>Year shortcut<select id="year-shortcut"><option value="">All years</option>{years.map(year=><option value={year}>{year}</option>)}</select></label><label>From<input name="from" type="date" min="1900-01-01" max={data.meta.researchCutoff}/></label><label>Through<input name="to" type="date" min="1900-01-01" max={data.meta.researchCutoff}/></label><label>Category<select name="category"><option value="">All categories</option>{categories.map(c=><option>{c}</option>)}</select></label><label>Person or institution<select name="entity"><option value="">All people & institutions</option>{entities.map(e=><option>{e}</option>)}</select></label><label>Evidence type<select name="evidence"><option value="">All evidence types</option>{Object.keys(evidenceDefinitions).map(e=><option>{e}</option>)}</select></label></div><label class="checkbox-label"><input name="context" type="checkbox"/> Include pre-2017 context in results</label></details>
        <div class="filter-bottom"><p id="result-count" role="status" aria-live="polite" aria-atomic="true">{story.length} timeline entries</p><button type="reset">Clear all</button></div><div id="active-filters" aria-label="Active filters"></div><p id="filter-warning" role="status" hidden></p>
      </form>
      <noscript><p class="no-script">The complete chronology is readable below. Interactive search and filtering need JavaScript; your browser’s Find command still works.</p></noscript>
      <p id="recent-note" class="view-note" hidden>Ordered by site revision date, not incident date. All initial entries were added together; later discoveries and material corrections appear here.</p>
      <details id="context-records" class="context-records"><summary>Earlier context <span>{context.length} entry · before the modern disclosure chronology</span></summary><div id="context-list">{context.map(e=><UfoEvent event={e} sources={data.sources} events={all}/>)}</div></details>
      <div id="timeline-results">{eras.map(era=><section class="timeline-era" id={`era-${era.id}`} data-era={era.id}><header class="era-heading"><span class="eyebrow">{era.label}</span><h3>{era.years}</h3><p>{era.summary}</p></header><div class="era-events">{story.filter(e=>e.date.start.slice(0,4)>=era.start && e.date.start.slice(0,4)<=era.end).map(e=><UfoEvent event={e} sources={data.sources} events={all}/>)}</div></section>)}</div>
      <div id="filtered-results" hidden></div>
      <div id="empty-state" class="empty-state" hidden><h3>No matching entries.</h3><p>Try a broader date range, fewer filters, or another spelling. This is a curated chronology, not a complete sightings database.</p><button class="button button-outline" type="button" id="empty-reset">Clear filters</button></div>
      <p id="link-status" role="status" aria-live="polite" class="link-status"></p>
    </section>

    <section class="questions-section" id="hypotheses" aria-labelledby="questions-title"><p class="eyebrow">Separate the questions</p><h2 id="questions-title">What would change our minds?</h2><p class="section-intro">These are proposed ways to investigate particular claims—not a ranking of universal explanations. Multiple causes can coexist. No probabilities are assigned.</p>
      <details class="editorial-detail"><summary>01 / Could ordinary objects or viewing geometry explain apparent motion?</summary><div><p><strong>Addresses:</strong> reports of unusual flight from limited imagery or perspective.</p><p><strong>Evidence and limits:</strong> ODNI identified a balloon in one case; its assessment did not resolve most others. A solution for one case cannot simply be transferred to another.</p><p><strong>Competing explanation:</strong> some reported motion could be genuinely unusual. A witness’s description alone does not provide calibrated velocity.</p><p><strong>Assumption to check:</strong> reliable distance, camera motion and timing can be reconstructed.</p><p><strong>Discriminating test:</strong> compare synchronized observations from separated, calibrated sensors against a conventional-object model, with error bounds.</p><p class="question-links"><a href="#odni-assessment">ODNI assessment</a><a href="#navy-videos">Video provenance</a></p></div></details>
      <details class="editorial-detail"><summary>02 / Are some reports human technology or a collection-system problem?</summary><div><p><strong>Addresses:</strong> detections near military operations, and disagreement between visual and instrument accounts.</p><p><strong>Evidence and limits:</strong> a military setting alone does not identify an operator, a vehicle or an instrument fault. The NASA study makes data quality central to investigation.</p><p><strong>Competing explanations:</strong> ordinary air traffic, environmental effects and genuinely unexplained observations require separate consideration.</p><p><strong>Assumptions to check:</strong> equipment behavior and relevant activity records are available for independent examination.</p><p><strong>Discriminating test:</strong> reconcile raw sensor logs, calibration, weather, traffic and authorized activity records. An explanation should predict the observations, not merely fit a label.</p><p class="question-links"><a href="#nasa-report">NASA research methods</a><a href="#senate-hearing-2024">AARO’s public assessment</a></p></div></details>
      <details class="editorial-detail"><summary>03 / What would substantiate a claim of non-human technology?</summary><div><p><strong>Addresses:</strong> alleged recovery programs, not every unidentified sighting.</p><p><strong>Evidence and limits:</strong> Grusch’s public statement records claims and leads. The underlying recovered objects are not publicly authenticated by that statement.</p><p><strong>Competing explanation:</strong> mistaken attribution, shared secondhand accounts or misunderstood human programs could also produce a claim. AARO’s contrary assessment is relevant but does not replace inspectable case evidence.</p><p><strong>Assumptions to check:</strong> alleged material exists, provenance is recoverable and “non-human” is a testable attribution rather than a residual label.</p><p><strong>Discriminating test:</strong> documented chain of custody, independently replicated examination and results that rule out terrestrial production or contamination. Unusual material alone would not establish intelligence.</p><p class="question-links"><a href="#grusch-public">Public allegations</a><a href="#house-hearing-2023">Prepared testimony</a><a href="#aaro-history-report">Historical assessment</a></p></div></details>
      <details class="editorial-detail"><summary>04 / What does secrecy tell us—and what does it not?</summary><div><p><strong>Addresses:</strong> withheld records, disclosure channels and alleged failures of oversight. This is an institutional question, separate from physical origin.</p><p><strong>Evidence and limits:</strong> the records law provides disclosure procedures and postponements. Their existence does not identify the contents of withheld material.</p><p><strong>Competing explanations:</strong> protection of sources or capabilities, administrative gaps and improper concealment are different possibilities; none should be presumed from a missing document alone.</p><p><strong>Assumption to check:</strong> an adequately complete inventory and audit trail can be produced.</p><p><strong>Discriminating test:</strong> compare agency inventories, transfer logs, redaction decisions and inspector-general findings against statutory requirements. Follow each discrepancy to a document.</p><p class="question-links"><a href="#archives-law">Enacted records framework</a><a href="#nara-first-release">First archive release</a><a href="#pursue-waiver">Restricted reporting channel</a></p></div></details>
    </section>

    <section class="methodology-section" id="methodology" aria-labelledby="methodology-title"><p class="eyebrow">Show the work</p><h2 id="methodology-title">A record that can be corrected.</h2>
      <details class="editorial-detail" open><summary>Methodology & source boundaries</summary><div><p>This is a curated chronology through {formatDate(data.meta.researchCutoff)}, not an exhaustive history or a finding about the origin of UAP. Earlier summaries were independently checked before inclusion. Primary material is preferred; supporting passages were read, not just link-tested.</p><p><strong>“Primary source read”</strong> means the original institutional record or testimony was inspected. <strong>“Reported milestone”</strong> means the accessible basis is identified reporting, with limits stated. Neither badge means an extraordinary claim has been proven.</p><p>Some NYT, Pentagon and procurement originals could not be inspected. Their entries use accessible corroboration and say so. Reprints and reports drawing from the same announcement are not independent evidence. Search snippets alone are not used as verification.</p><p>Dates preserve uncertainty. Month-only entries are placed within their month for navigation, without claiming a particular day or an order within that month. Incident, disclosure, publication and site-revision dates remain separate. Sequence does not imply causation.</p><p>Interpretive “why it matters” notes and proposed tests are editorial analysis. Report totals are not object totals. Laws using the term NHI do not establish its existence. No witness-character ratings, invented probabilities or evidence scores are used.</p><p>The page is unlisted and asks search engines not to index it. Anyone with the link can read or share it; it is not private or access-controlled.</p><button id="download-data" type="button" class="underlined" hidden>Download the inspectable dataset (JSON) ↓</button></div></details>
      <details class="editorial-detail" id="evidence-key"><summary>Evidence labels: what each one means</summary><dl>{Object.entries(evidenceDefinitions).map(([label,definition])=><div><dt>{label}</dt><dd>{definition}</dd></div>)}</dl></details>
      <details class="editorial-detail"><summary>Records collections & source notes</summary><div><p>NARA’s <a href={data.sources['nara-holdings'].url}>Record Group 615 listing ↗</a>, inspected September 19, 2026, includes FAA, NRC, ODNI, OSD, NSA, State Department, FBI and Air Force holdings. This current list does not date each transfer or demonstrate completeness.</p><p>Its webpage’s “last reviewed” stamp is not treated as a release announcement. The separately dated April 24, 2025 release remains a timeline event.</p><p>Grusch’s confidential complaints are described from the reporting that made them public, not represented as independently inspected filings. A separate June 2023 broadcast interview has not been added without an inspected original. Intermediate legislative stages and release tranches are not inferred from the final outcome.</p></div></details>
      <details class="editorial-detail" id="corrections"><summary>Corrections & material changes <span>{data.changeLog.length}</span></summary><ol class="change-list">{data.changeLog.map(c=><li><time datetime={c.date}>{formatDate(c.date)}</time><h3>{c.title}</h3><p>{c.detail}</p>{c.eventIds.map(id=><a href={`#${id}`}>Related entry ↗</a>)}</li>)}</ol></details>
      <div class="update-card"><div><p class="eyebrow">Update status</p><h3 id="update-status">{data.meta.updateStatus}</h3><p>{data.meta.updateDescription}</p></div><dl><div><dt>Last checked</dt><dd><time datetime={data.meta.lastCheckedAt}>{formatDate(data.meta.lastCheckedAt.slice(0,10))}</time></dd></div><div><dt>Content updated</dt><dd><time datetime={data.meta.contentUpdatedAt}>{formatDate(data.meta.contentUpdatedAt.slice(0,10))}</time></dd></div><div><dt>Published</dt><dd>{receipt ? <time datetime={receipt.verifiedAt}>Verified live {formatDate(receipt.verifiedAt.slice(0,10))}</time> : 'Awaiting live verification'}</dd></div><div><dt>Monitoring cadence</dt><dd>{data.meta.cadence} · substantive milestones only</dd></div></dl></div>
      <div class="contribute"><h3>A better source changes the record.</h3><p>Suggest a correction or a missing milestone. Include the event link, supporting source URLs and what the source actually establishes. Suggestions are reviewed; nothing is published automatically.</p><a class="button button-outline" href={contact}>Suggest a source or correction ↗</a></div>
    </section>
  </div>
  <script type="application/json" id="ufos-data" set:html={JSON.stringify(data).replace(/</g,'\\u003c')} />
  <script>import '../scripts/ufos-client.mjs';</script>
</Base>
