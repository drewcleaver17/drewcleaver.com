---
import Base from '../layouts/Base.astro';
import UfoEvent from '../components/UfoEvent.astro';
import UfoInstitutions from '../components/UfoInstitutions.astro';
import UfoReadingPaths from '../components/UfoReadingPaths.astro';
import { timelineProjection,personURL } from '../lib/ufo-people.mjs';
import data from '../data/ufos/timeline.json';
import { profile } from '../data/profile';
import { categories, topics, regions, evidenceDefinitions, eras, eraFor, readingPathOf, filterEvents, formatDate, validateDataset, yearsCovered } from '../lib/ufos.mjs';
import '../styles/ufos.css';
import '../styles/ufo-people-entry.css';
import NhiThemeControl from '../components/NhiThemeControl.astro';
import { contentDigest } from '../../scripts/ufos-update.mjs';
const errors = validateDataset(data);
if(errors.length) throw new Error(errors.join('\n'));
const all=filterEvents(data,{view:'history'});
const story=all.filter(e=>readingPathOf(e)==='main'), context=all.filter(e=>readingPathOf(e)==='supporting');
const featured=data.entities.filter(n=>(n as any).featured).sort((a,b)=>a.name.localeCompare(b.name));
const entities=data.entities;
const legacyEntities=[...new Set(all.flatMap(e=>[...e.people,...e.institutions]))].filter(name=>!entities.some(n=>n.name===name || n.aliases.includes(name) || (n as any).legacySearchLabels?.includes(name))).sort();
const years=yearsCovered(all);
const latestDate=all.reduce((max,e)=>[max,e.date.end || e.date.start || '0001'].sort().at(-1),'0001');
const latest=story.at(-1);
const eraExamples={origins:['jebel-irhoud','blombos-drawing'],'ancient-texts':['aryabhata-499','ibn-al-haytham-optics','gutenberg-printing'],foundations:['galileo-1610','darwin-wallace-1858','einstein-gr-1915'],war:['hiroshima-nagasaki-1945','national-security-act','arnold-report'],'cold-war':['blue-book-created','sputnik-1957','apollo-1969'],experiments:['rubin-rotation-curves','air-remote-viewing-review','ariel-1994'],archives:['phoenix-lights-1997','nimitz-encounter','ligo-2015'],attention:['nyt-2017','blc1-interference-analysis-2021','odni-assessment'],oversight:['nasa-report','archives-law','webb-2022'],records:['mars-potential-biosignature-2025','consciousness-cogitate-2025','aaro-workshop-records-published-2026']};
const entityName=id=>entities.find(n=>n.id===id)?.name || id;
const entityURL=id=>`?view=history&entity=${encodeURIComponent(id)}#timeline`;
const eventProps={sources:data.sources,events:all,entities:data.entities,relationships:data.relationships,sourceReviews:data.sourceReviews};
const contact=`mailto:${profile.email}?subject=${encodeURIComponent('NHI — source or correction')}&body=${encodeURIComponent('Entry or profile link:\n\nProposed correction or source:\n\nSupporting source URL(s) — required for review:\n\nWhat the source establishes (and does not establish):\n')}`;
const receipt=(data.meta as any).publicationReceipt;
const localPublication = value => new Intl.DateTimeFormat('en-US',{timeZone:'America/Chicago',year:'numeric',month:'short',day:'numeric',hour:'numeric',minute:'2-digit',second:'2-digit',timeZoneName:'short'}).format(new Date(value));
---
<Base title="NHI — New History Index" description="How did we get here? A curated timeline and reference guide to the discoveries, decisions and unanswered questions that shaped our world." compact>
  <div class="ufo-page shell" data-project="nhi" data-edition={data.meta.edition} data-content-digest={contentDigest(data)}>
    <header class="ufo-hero">
      <p class="eyebrow">An independent project by Drew Cleaver</p>
      <h1 class="index-name">New History Index<span>How did we get here?</span></h1>
      <p class="ufo-deck">A timeline and reference guide to the discoveries, decisions, and unanswered questions that shaped our world.</p>
      <div class="hero-bottom"><p>Explore human achievements, the choices behind them, and the evidence we can check. A recorded UFO account and a scientific finding are different kinds of knowledge.</p><a class="latest-link" href={`#${latest.id}`} id="jump-latest">Jump to latest <span aria-hidden="true">↓</span></a></div>
      <div class="hero-actions"><a href="#start-here" class="button">Start here ↓</a><a href="#timeline" class="underlined">Explore the timeline ↓</a><NhiThemeControl /></div>
      <div class="edition-strip"><span>R04 · New History Index</span><span>{story.length} main reading milestones · {all.length} retained records</span><span>{featured.length} featured people · all eras</span><span>Broad research cutoff {formatDate(data.meta.researchCutoff)}</span></div>
    </header>

    <section id="start-here" class="index-start" aria-labelledby="start-title"><p class="eyebrow">Shared historical grounding</p><h2 id="start-title">A place to begin.</h2><p>NHI means <strong>New History Index</strong> here. “New” describes this evolving presentation, not a replacement for established history. The collection is curated: it covers selected human origins, ideas, science, institutions, and unusual accounts, with uneven coverage across places and periods.</p><p>Read in order, or follow a topic. Ask what happened, how we know, and which human choices shaped the outcome. Better information can help a conversation; it does not settle every difference in values or trust. Curiosity about consciousness, UFOs, UAP (unidentified anomalous phenomena), USOs (unidentified submerged objects), and possible non-human intelligence stays open to evidence.</p><ol class="starter-path"><li><a href="#khufu-giza-engineering">Build: Egyptian engineering</a><span>Read the evidence for human skill and logistics.</span></li><li><a href="#dresden-codex-astronomy">Observe: Maya calendars</a><span>Separate a surviving manuscript from the older knowledge it records.</span></li><li><a href="#gutenberg-printing">Share: printing and knowledge</a><span>Follow a technology’s reach and its limits.</span></li><li><a href="#nasa-report">Investigate: evidence for unusual reports</a><span>Ask what a study establishes and what data are missing.</span></li></ol><p class="search-scope">These are stops in the same chronology, not a separate timeline. <a class="underlined" href="?view=journey#timeline" data-view="journey">Read from the beginning →</a></p><div class="ways-to-use"><p><strong>Learn or teach:</strong> choose an era, compare sources, and use a chapter question to discuss what changed.</p><p><strong>Explore with a friend:</strong> follow a topic and share an entry’s Link or Copy link.</p><p><strong>Check a claim:</strong> open its evidence notes, follow the cited passage, and check the source’s access and inspection limits.</p></div></section>
    <nav class="ufo-section-nav" aria-label="Page sections"><a href="#timeline">Timeline</a><a href="#institutions">Institutions & acronyms</a><a href="/nhi/people/" data-people-entry>People</a><a href="#methodology">About & method</a></nav>
    <nav class="era-map" aria-label="Historical phases">{eras.map(era=><a href={`#era-${era.id}`}><span class="eyebrow">{era.years}</span><strong>{era.label.split(" / ").at(-1)}</strong><span>{era.summary}</span></a>)}</nav>

    <section aria-labelledby="timeline-title" class="timeline-section" id="timeline">
      <div class="timeline-heading"><div><p class="eyebrow">The record, in sequence</p><h2 id="timeline-title">Read the history. Explore the evidence.</h2></div><a href="#hypotheses" class="underlined">Questions worth testing ↗</a></div>
      <UfoReadingPaths />
      <p id="people-return" class="people-upgrade" hidden><a href="/nhi/people/">← Return to people</a></p>
      <p id="scope-note" class="scope-note">Start with the main reading path across all eras. Full history retains supporting archival records, editions and investigations. Core/contextual is a separate classification from reading prominence or historical era.</p>
      <details class="editorial-detail" id="regional-guide"><summary>Explore / Ancient societies & regional histories</summary><div><p>Yucatán is a region within the wider Maya world. Maya peoples are living communities; “Mayan” is used here for languages. Mexica history is one part of Mesoamerica, and Teotihuacan predates the Mexica empire. The Amazon crosses national borders: the Casarabe study is in Bolivia, while the new Brazilian earthworks are named by state.</p><p>{Object.entries(regions).map(([id,label])=><a class="underlined" href={`?view=history&region=${id}#timeline`}>{label} → </a>)}</p><p>Read human achievements, recorded religious traditions, later discoveries and reported encounters in their own contexts. Similar pyramids, serpent images or dates do not prove shared origins or non-human involvement.</p><p><strong>Start here:</strong> <a href="#dresden-codex-astronomy">Maya calendars</a> · <a href="#tenochtitlan-water-city">Tenochtitlan</a> · <a href="#acre-geoglyph-forest-management-2017">Amazonian forest knowledge</a> · <a href="#khufu-giza-engineering">Egyptian engineering</a>. <a href="#varginha-1996-reports">Varginha’s reports and film</a> have a different evidence boundary.</p></div></details><div class="people-upgrade" id="featured-people"><div><strong>Meet the contributors</strong><span>{featured.length} featured people in the complete directory</span></div><a href="/nhi/people/?featured=1" data-people-entry>Browse featured people →</a></div>
      <details class="editorial-detail" id="texts-and-channeling"><summary>Reading guide / Nag Hammadi & the Law of One</summary><div><p>Two different records sit in this strand: the transmission of ancient religious literature and a modern group’s attributed channeling transcripts. Shared themes do not establish a historical connection or a common non-human source.</p><p><strong>Nag Hammadi:</strong> follow <a href="#nag-hammadi-composition">composition</a>, <a href="#nag-hammadi-codices">surviving copies and the unknown burial date</a>, <a href="#nag-hammadi-discovery">the 1945 discovery</a>, then <a href="#thomas-critical-edition-1959">critical editions</a>, <a href="#nag-hammadi-facsimiles">facsimiles</a> and <a href="#nag-hammadi-english-1977">English publication</a>. “Gnostic” is a scholarly and religious classification; the collection is not one uniform doctrine, and translation did not end interpretive debate.</p><p><strong>The Law of One:</strong> the dated reading guide groups the sessions by the original books. It gives selected themes from inspected passages, with links to the transcripts and <a href={data.sources['ra-session-directory'].url}>all 106 session dates ↗</a>. Book publication dates are kept separate from session dates.</p><p class="question-links"><a href="#ra-book-1-sessions">I · Unity & spiritual development</a><a href="#ra-book-2-sessions">II · Creation & free will</a><a href="#ra-book-3-sessions">III · Practice & balancing</a><a href="#ra-book-4-sessions">IV · Archetypes & symbols</a><a href="#ra-book-v-1998">V · Restored personal material</a></p><p>Compare the <a href="#ra-original-books-published">original publication</a>, <a href="#ra-final-session">last dated session</a> and <a href="#ra-contact-edition-2018">2018 two-volume edition</a>. The source notes distinguish participant recollections, edited transcripts and scholarly analysis.</p><a class="underlined" href="?view=history&topic=Religious%20texts%20%26%20channeling#timeline">Explore this historical strand →</a></div></details>
      <div class="reading-workspace">
      <form id="timeline-filters" class="filter-panel" role="search" aria-label="Search and filter timeline" hidden>
        <div class="filter-essentials"><h3>Shape your timeline</h3><NhiThemeControl /><label class="search-field">Search entries & source titles<input name="q" type="search" placeholder="Try Phoenix, Leavitt, evolution…" autocomplete="off" /></label><button type="button" id="clear-search" class="underlined">Clear search</button><p id="result-count" role="status" aria-live="polite" aria-atomic="true">{story.length} timeline entries</p><div id="active-filters" aria-label="Active filters"></div><button type="reset" class="underlined">Clear search & all filters</button><button type="button" data-copy-view class="underlined">Copy this filtered view</button><p class="search-scope">Choose one option per group. Different groups narrow results together. All search words must match.</p><a href="#timeline-filters" id="return-reading" class="underlined" hidden>Return to reading ↓</a></div><div class="filter-options" tabindex="0" role="region" aria-label="All timeline filter choices"><p class="scroll-hint">All choices are listed below. This long workspace scrolls on a large screen; use Tab, arrow keys, or scroll to reach each group.</p><div class="filter-top"><label>View<select name="view"><option value="journey">Main reading path · all eras</option><option value="story">Modern disclosure · 2017+</option><option value="core">Core timeline · all eras</option><option value="history">Full history & context</option><option value="institutions">Institutional history</option><option value="recent">Recently added or corrected</option></select></label><label>Order<select name="sort"><option value="oldest">Oldest first</option><option value="newest">Newest first</option></select></label></div>
        <div class="filter-grid"><label>Regional collection<select name="region"><option value="">All regional collections</option>{Object.entries(regions).map(([id,label])=><option value={id}>{label}</option>)}</select></label><label>Layer<select name="layer"><option value="">Both layers</option><option value="core">Core UFO timeline</option><option value="contextual">Contextual history</option></select></label><label>Era<select name="era"><option value="">All eras</option>{eras.map(era=><option value={era.id}>{era.years}</option>)}</select></label><label>Year overlap (CE)<select id="year-shortcut"><option value="">All years</option>{years.map(year=><option value={year}>{year}</option>)}</select></label><label>From (CE)<input name="from" type="date" min="0001-01-01" max={latestDate}/></label><label>Through (CE)<input name="to" type="date" min="0001-01-01" max={latestDate}/></label><label>Historical strand<select name="topic"><option value="">All strands</option>{topics.map(topic=><option>{topic}</option>)}</select></label><label>Category<select name="category"><option value="">All categories</option>{categories.map(c=><option>{c}</option>)}</select></label><label>Person, institution, program or work<select name="entity"><option value="">All names & works</option><optgroup label="Sourced index">{[...entities].sort((a,b)=>a.name.localeCompare(b.name)).map(e=><option value={e.id}>{e.name}</option>)}</optgroup><optgroup label="Other names in entries">{legacyEntities.map(e=><option>{e}</option>)}</optgroup></select></label><label>Evidence type<select name="evidence"><option value="">All evidence types</option>{Object.keys(evidenceDefinitions).map(e=><option>{e}</option>)}</select></label></div><label class="checkbox-label"><input name="context" type="checkbox"/>Include supporting context in a reading path</label>
        <p class="search-scope">Search covers entry text, names and aliases, categories, and source titles. It does not search full source documents. Year and date filters include overlapping ranges. Use Era for BCE and deep-time evidence; its ages retain the source’s uncertainty and convention.</p><p id="filter-warning" role="status" hidden></p></div>
      </form>
      <div class="timeline-feed">
      <div id="reading-tools" class="reading-tools" hidden><label>Search this timeline<input type="search" id="persistent-search" autocomplete="off" placeholder="Find an event or subject…"/></label><div class="reading-tools-bottom"><span id="persistent-count"></span><a href="#timeline-filters" id="adjust-filters">Adjust filters ↑</a><button type="button" id="persistent-reset">Clear all</button><button type="button" data-copy-view>Copy view</button></div><p id="persistent-state">Main reading path · no refinements</p></div>
      <noscript><p class="no-script">The complete chronology is readable below. Interactive search and filtering need JavaScript; your browser’s Find command still works.</p></noscript>
      <p id="recent-note" class="view-note" hidden>Ordered by site revision date, including historical additions. A record added today may concern an event centuries ago. Its historical date stays visible.</p>
      <details id="context-records" class="context-records"><summary>Supporting archive <span>{context.length} retained records · open to read without interactive controls</span></summary><div id="context-list">{context.map(e=><UfoEvent event={e} {...eventProps}/>)}</div></details>
      <div id="timeline-results">{eras.map(era=><section class="timeline-era" id={`era-${era.id}`} data-era={era.id}><header class="era-heading"><span class="eyebrow">{era.label}</span><h3>{era.years}</h3><a class="chapter-link" href={`#era-${era.id}`} aria-label={`Link to chapter: ${era.label}`}>Chapter link ↗</a><p>{era.summary}</p><p class="inquiry"><strong>Ask:</strong> {era.id==='origins'?'What can material evidence tell us, and what cannot survive in the record?':era.id==='foundations'?'What did a new tool make possible, and whose work helped it spread?':era.id==='war'?'How do an institution’s stated purpose and its documented actions compare?':era.id==='oversight'?'Which source records an action, and which source supports the underlying claim?':'What changed in this period, and which cited source supports that account?'}</p><p class="era-sources">{eraExamples[era.id].map(id=><a href={`#${id}`}>{all.find(e=>e.id===id)?.title}</a>)}</p></header><div class="era-events">{story.filter(e=>eraFor(e)?.id===era.id).map(e=><UfoEvent event={e} {...eventProps}/>)}</div></section>)}</div>
      <div id="filtered-results" hidden></div>
      <div id="empty-state" class="empty-state" hidden><h3>No matching entries.</h3><p>Try a broader date range, fewer filters, or another spelling. This is a curated chronology, not a complete sightings database.</p><button class="button button-outline" type="button" id="empty-reset">Clear filters</button></div>
      <button id="reveal-linked" type="button" class="button button-outline" hidden>Reveal linked entry in full history</button><p id="link-status" role="status" aria-live="polite" class="link-status"></p>
      </div></div>
    </section>

    <div aria-label="Legacy person links">{entities.filter(n=>n.type==='person').map(n=><article id={`entity-${n.id}`} tabindex="-1" class="person-anchor"><a href={personURL(n.id)} data-people-entry>Read {n.name}’s profile →</a></article>)}</div>
    <UfoInstitutions data={data}/>
    <section class="index-section" id="people-programs" aria-labelledby="index-title"><p class="eyebrow">Names behind the acronyms</p><h2 id="index-title">People, programs & institutions.</h2><p class="section-intro">Explore <a href="/nhi/people/" data-people-entry>all people in the directory</a>, or use an institution or work to filter the full history. These descriptions identify roles supported by cited records. A shared timeline is not a claim that every subject is connected.</p>
      <details class="editorial-detail" id="entity-directory"><summary>Explore works & other records <span>{entities.filter(n=>n.type!=='person' && !(n as any).institutionalProfile).length} records · institutional dossiers above</span></summary><div class="entity-grid">{entities.filter(n=>n.type!=='person' && !(n as any).institutionalProfile).sort((a,b)=>a.name.localeCompare(b.name)).map(n=><article class="entity-card" tabindex="-1" id={`entity-${n.id}`}><p class="eyebrow">{n.type}</p><h3><a href={entityURL(n.id)}>{n.name}</a></h3>{n.aliases.length>0 && <p class="entity-aliases">Also indexed: {n.aliases.join(' · ')}</p>}{(n as any).legacySearchLabels?.length>0 && <p>Legacy search labels, not verified alternate names: {(n as any).legacySearchLabels.join(' · ')}</p>}<p>{n.description}</p>{(n as any).inspectionScope && <p class="entity-aliases">Role inspection: {(n as any).inspectionScope.scope}</p>}{(n as any).featured && <><p><strong>Contribution:</strong> {(n as any).contribution}</p><p><strong>Scope:</strong> {(n as any).limitations}</p><p class="question-links">{n.eventIds.map(id=><a href={`#${id}`}>{all.find(e=>e.id===id)?.title}</a>)}</p></>}<p class="question-links">{data.relationships.filter(r=>r.from===n.id || r.to===n.id).map(r=><a href={`#relation-${r.id}`}>{r.type.replaceAll('-',' ')}: {entityName(r.from===n.id?r.to:r.from)}</a>)}</p><p class="entity-links"><a href={entityURL(n.id)}>Show {n.eventIds.length} related {n.eventIds.length===1?'entry':'entries'} →</a>{n.sources.map(ref=><a href={data.sources[ref.sourceId].url}>{data.sources[ref.sourceId].publisher}: supporting source ↗</a>)}</p></article>)}</div></details>
      <details class="editorial-detail" id="relationships"><summary>Documented roles & attributed connections <span>{data.relationships.length} source-scoped relationships</span></summary><div><p>“Documented” means the cited record supports the stated role. “Attributed” means an identified source asserts it. Neither label proves a larger theory. Dates apply only to the role or account described.</p>{data.relationships.map(r=><article class="relationship" id={`relation-${r.id}`} tabindex="-1"><p class="eyebrow">{r.status} · {r.type.replaceAll('-',' ')} · {formatDate(r.date.start)}{r.date.end && ` – ${formatDate(r.date.end)}`}</p><h3>{entityName(r.from)} {(r as any).directionality==='undirected'?'↔':'→'} {entityName(r.to)}</h3><p>{r.description}</p>{(r as any).dateBasis && <p>{(r as any).dateBasis}</p>}<p><strong>Limit:</strong> {r.limitations}</p><p class="question-links">{r.eventIds.map(id=><a href={`#${id}`}>Read the dated record →</a>)}{r.sources.map(ref=><a href={data.sources[ref.sourceId].url}>Supporting document ↗</a>)}</p></article>)}</div></details>
    </section>

    <section class="questions-section" id="hypotheses" aria-labelledby="questions-title"><p class="eyebrow">Separate the questions</p><h2 id="questions-title">What would change our minds?</h2><p class="section-intro">These are proposed ways to investigate particular claims—not a ranking of universal explanations. Multiple causes can coexist. No probabilities are assigned.</p>
      <details class="editorial-detail"><summary>01 / Could ordinary objects or viewing geometry explain apparent motion?</summary><div><p><strong>Addresses:</strong> reports of unusual flight from limited imagery or perspective.</p><p><strong>Evidence and limits:</strong> ODNI identified a balloon in one case; its assessment did not resolve most others. A solution for one case cannot simply be transferred to another.</p><p><strong>Competing explanation:</strong> some reported motion could be genuinely unusual. A witness’s description alone does not provide calibrated velocity.</p><p><strong>Assumption to check:</strong> reliable distance, camera motion and timing can be reconstructed.</p><p><strong>Discriminating test:</strong> compare synchronized observations from separated, calibrated sensors against a conventional-object model, with error bounds.</p><p class="question-links"><a href="#odni-assessment">ODNI assessment</a><a href="#navy-videos">Video provenance</a></p></div></details>
      <details class="editorial-detail"><summary>02 / Are some reports human technology or a collection-system problem?</summary><div><p><strong>Addresses:</strong> detections near military operations, and disagreement between visual and instrument accounts.</p><p><strong>Evidence and limits:</strong> a military setting alone does not identify an operator, a vehicle or an instrument fault. The NASA study makes data quality central to investigation.</p><p><strong>Competing explanations:</strong> ordinary air traffic, environmental effects and genuinely unexplained observations require separate consideration.</p><p><strong>Assumptions to check:</strong> equipment behavior and relevant activity records are available for independent examination.</p><p><strong>Discriminating test:</strong> reconcile raw sensor logs, calibration, weather, traffic and authorized activity records. An explanation should predict the observations, not merely fit a label.</p><p class="question-links"><a href="#nasa-report">NASA research methods</a><a href="#senate-hearing-2024">AARO’s public assessment</a></p></div></details>
      <details class="editorial-detail"><summary>03 / What would substantiate a claim of non-human technology?</summary><div><p><strong>Addresses:</strong> alleged recovery programs, not every unidentified sighting.</p><p><strong>Evidence and limits:</strong> Grusch’s public statement records claims and leads. The underlying recovered objects are not publicly authenticated by that statement.</p><p><strong>Competing explanation:</strong> mistaken attribution, shared secondhand accounts or misunderstood human programs could also produce a claim. AARO’s contrary assessment is relevant but does not replace inspectable case evidence.</p><p><strong>Assumptions to check:</strong> alleged material exists, provenance is recoverable and “non-human” is a testable attribution rather than a residual label.</p><p><strong>Discriminating test:</strong> documented chain of custody, independently replicated examination and results that rule out terrestrial production or contamination. Unusual material alone would not establish intelligence.</p><p class="question-links"><a href="#grusch-public">Public allegations</a><a href="#house-hearing-2023">Prepared testimony</a><a href="#aaro-history-report">Historical assessment</a></p></div></details>
      <details class="editorial-detail"><summary>04 / What does secrecy tell us—and what does it not?</summary><div><p><strong>Addresses:</strong> withheld records, disclosure channels and alleged failures of oversight. This is an institutional question, separate from physical origin.</p><p><strong>Evidence and limits:</strong> the records law provides disclosure procedures and postponements. Their existence does not identify the contents of withheld material.</p><p><strong>Competing explanations:</strong> protection of sources or capabilities, administrative gaps and improper concealment are different possibilities; none should be presumed from a missing document alone.</p><p><strong>Assumption to check:</strong> an adequately complete inventory and audit trail can be produced.</p><p><strong>Discriminating test:</strong> compare agency inventories, transfer logs, redaction decisions and inspector-general findings against statutory requirements. Follow each discrepancy to a document.</p><p class="question-links"><a href="#archives-law">Enacted records framework</a><a href="#nara-first-release">First archive release</a><a href="#pursue-waiver">Restricted reporting channel</a></p></div></details>
      <details class="editorial-detail"><summary>05 / Do remote-viewing results establish a repeatable information channel?</summary><div><p><strong>Addresses:</strong> SRI/SAIC laboratory results and their proposed operational use. It does not treat every altered-state experience as the same phenomenon.</p><p><strong>Support and limits:</strong> Puthoff and Targ reported favorable experiments; Utts argued that the later evidence established anomalous cognition. Hyman disputed that causal inference. AIR separated statistical results from intelligence usefulness and recommended against continuation.</p><p><strong>Competing explanations:</strong> residual information leakage, judging effects, selection and unrecognized methodological artifacts; alternatively, a replicable effect not yet explained by the tested models.</p><p><strong>Assumptions:</strong> targets remain concealed, scoring is fixed in advance, all trials are retained, and independent teams can reproduce the procedure.</p><p><strong>Discriminating test:</strong> preregister blinded trials with auditable target selection, independent judging, negative controls and publication of failures as well as successes. Test operational decisions separately from laboratory hit rates.</p><p class="question-links"><a href="#sri-perceptual-research">SRI claims</a><a href="#remote-viewing-review-disagreement">The reviewers’ disagreement</a><a href="#air-remote-viewing-review">AIR’s final evaluation</a><a href="#gateway-assessment">Gateway’s separate provenance</a></p></div></details>
      <details class="editorial-detail"><summary>06 / Do financial or personnel connections establish a hidden program?</summary><div><p><strong>Addresses:</strong> claims that wartime business, intelligence personnel and later programs form one continuous operation.</p><p><strong>Support and limits:</strong> the UBC order establishes a specific vesting action; the WCC memo establishes representation by Donovan’s law firm; EW-Pa 128 preserves an informant’s report. These are different records with different scopes.</p><p><strong>Competing explanation:</strong> professional networks and postwar reorganizations can produce overlaps without the proposed covert mission.</p><p><strong>Assumptions:</strong> the same legal entities and people are being identified correctly, records are authentic, and a claimed relationship persisted during the relevant period.</p><p><strong>Discriminating evidence:</strong> authenticated, contemporaneous tasking, contracts, payments and custody records that connect the specific actors to the specific claimed activity. A missing file or shared date does not supply that chain.</p><p class="question-links"><a href="#union-banking-vesting">UBC order</a><a href="#wcc-donovan-memo">WCC memorandum</a><a href="#maison-rouge-report">Maison Rouge report</a></p></div></details>
    </section>

    <section class="methodology-section" id="methodology" aria-labelledby="methodology-title"><p class="eyebrow">About & method</p><h2 id="methodology-title">An evolving historical index.</h2>
      <div class="section-intro" id="orientation-title"><p>Drew Cleaver is assembling this independent project to explore how humanity’s understanding of reality has changed—and how the open questions fit into that history. Follow scientific discoveries, pivotal people, institutions, technology, consciousness research and reported encounters through the timeline and directories.</p><p>“New History” means revisiting history with additional context, evidence and connections. It does not claim a newly proven replacement for established history. NHI intentionally echoes <em>non-human intelligence</em>: an important question within the index, not an assumed explanation for every event.</p></div>
      <details class="editorial-detail" open><summary>Methodology & source boundaries</summary><div><p>This is a curated chronology, not an exhaustive history or a finding about the origin of UAP. {data.meta.researchCoverage} Primary material is preferred. Each source panel states what was inspected and which claims the passage supports.</p><p>Claim labels describe the kind of record or assertion. Source inspection, access and common origin appear separately in each source panel. Reading primary testimony establishes what was said, not whether every underlying claim is true.</p><p>Some NYT, Pentagon and procurement originals could not be inspected. Their entries identify the reporting or archival copies actually inspected. Reprints and reports drawing from the same announcement are not independent evidence. Search snippets alone are not used as verification.</p><p>Dates preserve uncertainty. Archaeological ages describe the evidence, not a precise origin of humanity or cognition. “Years ago” preserves the cited study’s estimate and uncertainty. The two archaeological entries do not establish a BP-1950 baseline: their publication years anchor ordering only, as disclosed in their age notes. These coordinates are not measured calendar dates. BCE dates have no year zero. Approximate ranges serve navigation, not exact dating. Month-only entries are placed within their month for navigation, without claiming a particular day or an order within that month. Incident, disclosure, publication and site-revision dates remain separate. Sequence does not imply causation.</p><p>Selection favors consequence, enduring influence, reader relevance, documentary support, distinctive contribution and a clear place in the chronology. This is not an exhaustive ranking. Cultural importance and evidentiary strength are different judgments. “Read alongside” links are editorial context; sourced relationships state their narrower documentary basis. Interpretive “why it matters” notes and proposed tests are editorial analysis. Report totals are not object totals. A law’s use of “non-human intelligence” does not establish that such intelligence exists. In historical legal records, the abbreviation NHI refers to that term, not to the name of this index. No witness-character ratings, invented probabilities or evidence scores are used.</p><p><strong>Terms:</strong> UFO means unidentified flying object; UAP is a broader reporting term, commonly “unidentified anomalous phenomena.” Documented events, reported experiences, attributed claims, interpretations, unresolved questions and established explanations retain their distinct labels.</p><button id="download-data" type="button" class="underlined" hidden>Download the inspectable dataset (JSON) ↓</button></div></details>
      <div class="index-method-note"><h3>How this index is built</h3><p>Compiled and edited by <strong>Drew Cleaver</strong>. This is an independent editorial project, not a peer-reviewed textbook or a complete ranking of world history. Entries earn their place by explaining changes in knowledge, capability, society, power, or influential unresolved questions. The current collection remains strongest in modern science and U.S. institutions.</p><p>Source notes separate established findings, documented accounts, cultural traditions, contested interpretations, and speculation. An investigation proves that an investigation happened; it does not prove an extraordinary explanation. “Read alongside” links are editorial comparisons. Nearby dates do not establish cause and effect.</p><p><strong>Citing the index:</strong> Drew Cleaver (compiler/editor), “New History Index” or the entry title, R04, the stable page/entry URL, and your access date. For a factual claim, cite the original source whenever possible. This guide is a synthesis, not independent corroboration. Revision history and scoped inspection receipts appear below; the broad research cutoff is not a claim that all links were checked today.</p></div>
      <details class="editorial-detail" id="evidence-key"><summary>Evidence labels: what each one means</summary><dl>{Object.entries(evidenceDefinitions).map(([label,definition])=><div><dt>{label}</dt><dd>{definition}</dd></div>)}</dl></details>
      <details class="editorial-detail"><summary>Records collections & source notes</summary><div><p>NARA’s <a href={data.sources[data.meta.holdingsSourceId].url}>Record Group 615 listing ↗</a>, observed October 11, 2026 UTC (October 10 US/Central), includes FAA, NRC, ODNI, OSD, NSA, State Department, FBI, Air Force and CBP holdings. This current list does not date each transfer or demonstrate completeness.</p><p>Its webpage’s “last reviewed” stamp is not treated as a release announcement. The separately dated April 24, 2025 release remains a timeline event.</p><p>Grusch’s confidential complaints are described from the reporting that made them public, not represented as independently inspected filings. A separate June 2023 broadcast interview has not been added without an inspected original. Intermediate legislative stages and release tranches are not inferred from the final outcome.</p></div></details>
      <details class="editorial-detail" id="check-receipts"><summary>What the latest checks covered</summary><div><p>The last-check date is scoped to these receipts; it does not mean every complete publication was newly inspected. A manual editorial release does not establish that a scheduled run succeeded.</p>{data.meta.checkReceipts.map(check=><article class="check-receipt"><h3>{formatDate(check.checkedAt.slice(0,10))}</h3><p>{check.scope}</p><p>{check.basis}</p></article>)}</div></details><details class="editorial-detail" id="corrections"><summary>Corrections & material changes <span>{data.changeLog.length}</span></summary><ol class="change-list">{data.changeLog.map(c=><li><time datetime={c.date}>{formatDate(c.date)}</time><h3>{c.title}</h3><p>{c.detail}</p>{c.eventIds.map(id=><a href={`#${id}`}>Related entry ↗</a>)}</li>)}</ol></details>
      <details class="editorial-detail"><summary>Historical coverage, provenance & open research</summary><div><p>Original documents, archival finding aids, institutional histories, participant accounts and journalism are labeled separately. An archive may preserve a document it did not author. A declassification stamp is not necessarily the first public-release date. A source’s finding is attributed to that source.</p><p>Some requested strands remain open: exact World Commerce Corporation formation records; the original 1933 Italian documents; a fuller SUN STREAK chronology and predecessor-program orders; authenticated roles and dates for Ingo Swann and Pat Price; complete original Lazar broadcasts beyond the inspected retrospective; and further international investigations beyond the bounded entries added here. An inaccessible original is not marked verified.</p><p>Period reporting, including The New York Times when available, is valuable for establishing what was public at the time. It does not replace examination of the underlying evidence. Podcasts and interviews can suggest records to investigate; repeated coverage of one account is not independent corroboration.</p><p>The downloadable dataset includes source-specific support, author/custodian provenance for new historical sources, date qualifications and typed relationships. It contains no private correspondence or visitor submissions.</p></div></details>
      <div class="update-card"><div><p class="eyebrow">Update status</p><h3 id="update-status">{data.meta.updateStatus}</h3><p>{data.meta.updateDescription}</p></div><dl><div><dt>Last scoped check</dt><dd><time datetime={data.meta.lastCheckedAt}>{formatDate(data.meta.lastCheckedAt.slice(0,10))}</time></dd></div><div><dt>Editorial content update</dt><dd><time datetime={data.meta.contentUpdatedAt}>{formatDate(data.meta.contentUpdatedAt.slice(0,10))}</time></dd></div><div><dt>Published</dt><dd>{receipt ? <time datetime={receipt.verifiedAt}>Verified live {localPublication(receipt.verifiedAt)}</time> : 'Awaiting live verification'}</dd></div><div><dt>Monitoring cadence</dt><dd>{data.meta.cadence} · substantive milestones only</dd></div></dl></div>
      <div class="contribute"><h3>A better source changes the record.</h3><p>Suggest a correction or a missing milestone. Include the event link, supporting source URLs and what the source actually establishes. Suggestions are reviewed; nothing is published automatically.</p><a class="button button-outline" href={contact}>Suggest a source or correction ↗</a></div>
    </section>
