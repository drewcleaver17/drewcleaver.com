---
import catalog from '../../data/45north.json';
import instrument from '../../data/45north-survey.json';
import { profile } from '../../data/profile';
import IssueRatingRow from '../../components/IssueRatingRow.astro';

const title = '45 North · Rate the Top 45 — Drew Cleaver';
const description = 'Give each issue its own 1–10 priority rating. Read all 45 proposals, suggest a change, and explore community results.';
const canonical = new URL('/45north/', profile.website).href;
const api = import.meta.env.PUBLIC_45NORTH_API ?? 'https://forty-five-north-api.drewcleaver.chatgpt.site';
const preview = ['1', 'true'].includes(import.meta.env.PUBLIC_45NORTH_PREVIEW ?? '');
const wording = new Map(instrument.map(issue => [issue.id, issue]));
const seed = catalog.map(issue => ({...issue, ...wording.get(issue.id)}))
  .sort((a, b) => a.title.localeCompare(b.title, 'en'));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#193f35" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="45 North · Rate the Top 45" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/45north/assets/issue-list.css" />
    <link rel="stylesheet" href="/45north/assets/issue-list-results.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="north-app" data-north data-api={api} data-email={profile.email} data-preview={preview ? 'true' : undefined}>
      <header class="masthead">
        <div class="wrap masthead-inner">
          <a class="north-mark" href="/45north/" aria-label="45 North home"><span class="direction" aria-hidden="true"></span><span><strong>45</strong> North</span></a>
          <a class="owner" href="/">{profile.name}<span aria-hidden="true">↗</span></a>
        </div>
      </header>
      {preview && <p class="wrap preview-note">Owner-only rehearsal. Everyone here shares one test connection.</p>}
      <main class="wrap" id="main" tabindex="-1">
        <section id="list-view" aria-labelledby="list-title">
          <div class="intro">
            <div class="intro-copy">
              <h1 id="list-title" tabindex="-1">Rate the Top <em id="list-count">{Math.min(45, seed.length)}</em></h1>
              <p class="priority-question" id="rating-question">How much of a priority should this change be in your community?</p>
              <p class="intro-hint">Tap a number to save. Rate as many issues as you like.</p>
            </div>
            <p class="scale-key" id="scale-anchors"><span><strong>1</strong> Lowest priority</span><span class="scale-line" aria-hidden="true"></span><span><strong>10</strong> Highest priority</span></p>
            <span id="rating-label" class="sr-only">Priority rating for</span>
          </div>
          <div class="list-toolbar">
            <label class="search-box" for="search"><span class="search-glyph" aria-hidden="true"></span><span class="sr-only">Find an issue by words, topic or issue number</span><input id="search" type="search" placeholder="Find an issue or topic" autocomplete="off" /></label>
            <label class="result-switch"><input id="show-results" type="checkbox" aria-controls="results-tools issue-list" /> <span>Show community results</span></label>
            <details class="suggest-panel" id="suggest-panel">
              <summary><span class="add" aria-hidden="true">+</span> Suggest an issue</summary>
              <form id="suggest-form" class="suggest-form">
                <label for="suggest-text">What would you change?</label>
                <p class="form-hint" id="suggest-hint">One sentence is enough. Leave out personal details.</p>
                <textarea id="suggest-text" name="text" required maxlength="500" rows="3" aria-describedby="suggest-hint"></textarea>
                <div data-role="matches" class="form-matches"></div>
                <button type="submit" class="primary-action" disabled>Send suggestion</button>
                <div data-role="form-result" aria-live="polite" class="form-result"></div>
              </form>
            </details>
          </div>
          <div id="results-tools" hidden></div>
          <div class="list-status">
            <p class="privacy-short">{preview ? 'On the public survey · ' : ''}No cookies. No Google or ad tracking. No account needed.</p>
            <p id="search-summary" class="search-summary" role="status"></p>
            <a href="#suggest" id="search-suggest" hidden>Suggest this issue</a>
          </div>
          <p id="catalog-notice" role="status" hidden></p>
          <noscript><p class="noscript">You can read every launch proposal here. Enable JavaScript to send a rating or load live results.</p></noscript>
          <div class="list-labels" aria-hidden="true"><span>Issue</span><span>Your priority</span></div>
          <div id="issue-list" class="issue-list">
            {seed.slice(0,45).map(idea => <IssueRatingRow idea={idea} />)}
          </div>
          <script is:inline>
            // Start the reader in a neutral order before the service refreshes the live roster.
            (() => {
              const list = document.getElementById('issue-list');
              const rows = Array.from(list.children);
              for (let i = rows.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [rows[i], rows[j]] = [rows[j], rows[i]];
              }
              const ordered = document.createDocumentFragment();
              rows.forEach(row => ordered.append(row));
              list.append(ordered);
              list.dataset.shuffled = 'true';
            })();
          </script>
          <template id="issue-row-template"><IssueRatingRow /></template>
          <button type="button" class="secondary-action more-issues" id="more-issues" hidden>Show other issues</button>
          <section class="guide" aria-label="About this survey">
            <details id="survey-method">
              <summary>How ratings work</summary>
              <p>Each issue uses the same 1–10 scale. You can give several changes the same score, leave an issue unrated, or change a rating. A low score can mean other needs come first.</p>
              <p>The landing list is shuffled for each visit. If more than 45 issues are active, the Top 45 are selected by median priority, then number of ratings, then permanent issue number. Unrated issues follow rated issues. Search or show other issues to reach the rest.</p>
              <p>Each public connection can hold one current rating per issue. A new rating or a change counts for 30 days. Repeating the same number keeps its expiry. Open an issue’s details to remove a rating.</p>
              <p>Drew Cleaver runs this voluntary survey. People can decide which issues to rate, and shared connections count once per issue. The results describe participating connections and show each issue’s own response count. The earlier up/down chart has a separate archive.</p>
            </details>
            <details id="north-privacy">
              <summary>Privacy and shared connections</summary>
              <p>The survey turns a connection’s public IP address into a private, issue-specific code. The rating database stores the code and score without the raw IP. People sharing an address can replace each other’s rating on an issue. A changed address can count as another connection.</p>
              <p>GitHub Pages logs IP addresses for security. OpenAI Sites and Cloudflare process connection information to deliver and protect the service. Their infrastructure logs may include IP, time, route and status. The application writes no request-body or choice logs. Cloudflare can return a security-cookie header. The public survey omits credentials on every service request, so browsers neither accept nor send that cookie.</p>
              <p>Searches stay in this browser. Sending a suggestion or pilot lead puts it in Drew’s private review queue. A private status link lets you check the outcome. Public sharing uses only an issue’s title, question and permanent address.</p>
              {preview && <p>The private rehearsal uses its existing owner sign-in. Its ratings are separate from the public survey.</p>}
            </details>
            <details><summary>Why 45 North?</summary><p>The name borrows from Houston’s I‑45 and gives a nod to 85 South. Trump’s first term raised a question for Drew. Which changes would people living with these decisions put first?</p></details>
          </section>
        </section>
        <section id="status-view" class="status-view" hidden></section>
      </main>
      <footer class="wrap site-credit"><span>45 North</span><a href="/">{profile.name} <span aria-hidden="true">↗</span></a></footer>
      <script is:inline type="application/json" id="north-catalog" set:html={JSON.stringify(seed).replaceAll('<', '\\u003c')} />
    </div>
    <script is:inline type="module" src="/45north/assets/issue-list.mjs"></script>
  </body>
</html>
