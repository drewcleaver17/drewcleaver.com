---
import Base from '../../layouts/Base.astro';
import PortfolioVisual from '../../components/PortfolioVisual.astro';
import { portfolio } from '../../data/portfolio';
import '../../styles/portfolio.css';
---
<Base title="Selected work · Portfolio preview" description="A review collection of Drew Cleaver’s consumer products, advisory practice, service concepts, motorsport projects and reusable software." compact noindex>
  <div class="shell folio-wrap">
    <div class="folio-review"><span class="folio-dot" aria-hidden="true"></span><strong>Portfolio preview</strong><span>Unlisted · For review</span></div>
    <header class="folio-intro">
      <p class="eyebrow">Drew Cleaver / Selected work</p>
      <h1 class="serif">Ideas made<br /><em>tangible.</em></h1>
      <div class="folio-intro-copy">
        <p>Products, advisory work, services, track projects and tools. A closer look at what I’ve worked on, the part I played, and the work you can still explore.</p>
        <a class="text-link" href="#projects">Explore {portfolio.length} projects <span aria-hidden="true">↓</span></a>
      </div>
    </header>
    <section id="projects" aria-labelledby="projects-title">
      <div class="folio-section-heading"><h2 id="projects-title" class="eyebrow">Selected projects</h2><p>01 — {String(portfolio.length).padStart(2, '0')}</p></div>
      <div class="folio-projects">
        {portfolio.map(project => (
          <article class="folio-card">
            <PortfolioVisual project={project} />
            <div class="folio-card-copy">
              <p class="folio-category"><span>{project.number}</span>{project.category}</p>
              <h3 class="serif"><a href={`/portfolio/${project.slug}/`}>{project.name}<span class="folio-card-arrow" aria-hidden="true">↗</span></a></h3>
              <p class="folio-summary">{project.summary}</p>
              <div class="folio-card-foot"><span>{project.status}</span><a href={`/portfolio/${project.slug}/`} aria-label={`Read the ${project.name} case study`}>Read case study <span aria-hidden="true">→</span></a></div>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="folio-open" aria-labelledby="open-title">
      <div><p class="eyebrow">Something you can use</p><h2 id="open-title" class="serif">Make it your own.</h2></div>
      <div><p>Buildmine is the reusable part of this collection: a personal-site starter with editable content, source code and a guide to publishing it yourself.</p><a class="text-link" href="/portfolio/buildmine/">See what’s included <span aria-hidden="true">→</span></a></div>
    </section>
    <aside class="folio-review-note" aria-label="About this preview"><strong>About this preview</strong><p>This collection is available by direct link and is not listed in the site navigation or sitemap. Search engines are asked not to index it. It is not password-protected. Historical websites retain their dates and context; the Higher Hangers storefront archive is still to be added.</p></aside>
  </div>
</Base>
