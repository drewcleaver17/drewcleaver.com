---
import NhiRedirect from '../../../components/NhiRedirect.astro';
import data from '../../../data/ufos/timeline.json';
import { personURL } from '../../../lib/ufo-people.mjs';
export function getStaticPaths() {return data.entities.filter(n=>n.type==='person').map(person=>({params:{id:person.id},props:{person}}));}
const { person } = Astro.props;
---
<NhiRedirect destination={personURL(person.id)} />
