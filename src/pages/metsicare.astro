  .metsi a:focus-visible,summary:focus-visible { outline:3px solid #af6d2e; outline-offset:5px; }
  .note { font-size:.91rem; color:var(--muted); line-height:1.65; }
  .callout { border-left:3px solid var(--accent); padding:8px 0 8px 22px; margin:28px 0; font-size:1.16rem; font-weight:600; line-height:1.6; }
  .plans,.responsibilities { display:grid; grid-template-columns:1fr 1fr; gap:40px; margin:34px 0; }
  .plan { border-top:3px solid var(--ink); padding-top:22px; }
  .plan h3 { font-size:1.4rem; }
  .price { color:var(--accent); font-size:3.7rem; letter-spacing:-.045em; font-weight:700; line-height:1.2; margin:18px 0; }
  .price span { font-size:1rem; color:var(--muted); font-weight:400; letter-spacing:0; margin-left:6px; }
