    section { padding:46px 0; }
    section p { font-size:1rem; line-height:1.75; }
    .eyebrow { font-size:.71rem; line-height:1.6; }
    .plans,.responsibilities { grid-template-columns:1fr; gap:30px; }
    .price { font-size:3.1rem; }
    .steps li { padding-left:35px; }
    .schedule>div { grid-template-columns:98px minmax(0,1fr); gap:16px; }
    dt,dd { font-size:.94rem; }
    .economics>div,.costs>div { gap:12px; }
    .economics dd,.costs dd { font-size:.94rem; }
    details { padding:0 14px; }
