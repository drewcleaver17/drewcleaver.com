  .hero-thesis { font-size:clamp(1.7rem,3.5vw,3rem); font-weight:600; line-height:1.2; letter-spacing:-.025em; max-width:900px; margin:0 0 28px; }
  .hero-intro { color:#d7e1d5; font-size:clamp(1.1rem,2vw,1.3rem); max-width:740px; line-height:1.65; }
  .download { display:inline-flex; align-items:center; justify-content:space-between; gap:32px; border:1px solid #94ac94; color:#fff; padding:15px 20px; min-height:48px; margin:16px 0 24px; text-decoration:none; font-weight:700; }
  .download:hover { background:#235c48; }
  .disclosure { color:#d3dfce; max-width:830px; font-size:.875rem; line-height:1.6; margin:0; }
  .reading { max-width:920px; }
  section { padding:64px 0; border-bottom:1px solid var(--border); scroll-margin-top:32px; }
  .metsi h2 { font-size:clamp(1.7rem,3.2vw,2.65rem); line-height:1.2; font-weight:700; letter-spacing:-.03em; max-width:850px; margin:0 0 28px; color:var(--ink); }
  .metsi h3 { font-size:1.16rem; line-height:1.35; margin:0 0 8px; color:var(--ink); font-weight:700; letter-spacing:-.01em; }
  section p { font-size:1.08rem; line-height:1.8; margin:0 0 20px; }
  section p:last-child { margin-bottom:0; }
