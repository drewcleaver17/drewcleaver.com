---
import Base from '../layouts/Base.astro';
import { videos, durationLabel } from '../data/youtube';

const topics = [...new Set(videos.flatMap(video => video.topics))].sort();
---
<Base title="YouTube library" description="Drew Cleaver’s saved YouTube videos, organized by topic with short summaries and personal context." noindex>
  <section class="shell video-library" aria-labelledby="library-title">
    <header class="library-heading">
      <div>
        <p class="library-kicker">Drew’s collection</p>
        <h1 id="library-title">YouTube library<span aria-hidden="true">.</span></h1>
        <p class="library-intro">Favorite videos, short summaries, and the context behind saving them.</p>
      </div>
      <p class="library-total"><strong>{videos.length}</strong> {videos.length === 1 ? 'video' : 'videos'}</p>
    </header>

    <form class="library-controls" id="library-controls" role="search" hidden>
      <div class="search-field">
        <label for="video-search">Search the collection</label>
        <input id="video-search" type="search" placeholder="A topic, creator, or idea…" autocomplete="off" disabled={!videos.length} />
      </div>
      <div>
        <label for="video-length">Watch time</label>
        <select id="video-length" disabled={!videos.length}>
          <option value="all">Any length</option>
          <option value="short">Under 10 minutes</option>
          <option value="medium">10–30 minutes</option>
          <option value="long">30 minutes or more</option>
        </select>
      </div>
      <div>
        <label for="video-sort">Sort by</label>
        <select id="video-sort" disabled={!videos.length}>
          <option value="curated">Collection order</option>
          <option value="recent">Recently added</option>
          <option value="shortest">Shortest first</option>
          <option value="title">Title A–Z</option>
        </select>
      </div>
      <div class="topic-filters" role="group" aria-label="Filter by topic">
        <button type="button" class="topic-button" data-topic="" aria-pressed="true">All topics</button>
        {topics.map(topic => <button type="button" class="topic-button" data-topic={topic} aria-pressed="false">{topic}</button>)}
      </div>
    </form>

    <div class="results-bar" hidden={!videos.length}>
      <p id="video-count" role="status" aria-live="polite" aria-atomic="true">{videos.length} {videos.length === 1 ? 'video' : 'videos'}</p>
      <button id="clear-filters" class="text-button" type="button" hidden>Clear filters</button>
    </div>

    <div class="video-grid" id="video-grid">
      {videos.map((video, index) => {
        const youtubeUrl = `https://www.youtube.com/watch?v=${video.id}`;
        const searchText = [video.title, video.channel, ...video.topics, video.summary?.text, ...(video.summary?.takeaways || []), video.context].filter(Boolean).join(' ');
        return <article class="video-card" id={`video-${video.id}`} data-video-id={video.id} data-title={video.title} data-search={searchText} data-topics={JSON.stringify(video.topics)} data-added={video.addedOn} data-duration={video.durationSeconds ?? ''} data-order={index}>
          <a class="thumbnail" href={youtubeUrl} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${video.title} on YouTube (new tab)`}>
            <img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" decoding="async" />
            {video.durationSeconds && <span class="duration">{durationLabel(video.durationSeconds)}</span>}
          </a>
          <div class="video-card-body">
            <p class="video-channel">{video.channel}</p>
            <h2><a href={youtubeUrl} target="_blank" rel="noopener noreferrer">{video.title}<span class="sr-only"> (YouTube, new tab)</span></a></h2>
            <ul class="video-topics" aria-label="Topics">{video.topics.map(topic => <li>{topic}</li>)}</ul>
            <div class="video-summary">
              <h3>TL;DW</h3>
              <p>{video.summary?.text ?? 'Summary not added yet.'}</p>
            </div>
            {(video.summary || video.context) && <details class="video-notes">
              <summary>Takeaways &amp; context</summary>
              {Boolean(video.summary?.takeaways?.length) && <ul class="takeaways">{video.summary!.takeaways!.map(point => <li>{point}</li>)}</ul>}
              {video.context && <div class="drew-context"><h3>Why I saved it</h3><p>{video.context}</p></div>}
              {video.summary && <p class="summary-source">Summary based on: {video.summary.basis}. <a href={video.summary.sourceUrl} target="_blank" rel="noopener noreferrer">Source<span class="sr-only"> (new tab)</span></a></p>}
            </details>}
            <div class="video-actions">
              {video.embed !== 'unavailable' && <button class="watch-button" type="button" data-watch={video.id} hidden aria-haspopup="dialog">Watch here</button>}
              <a href={youtubeUrl} target="_blank" rel="noopener noreferrer">Open YouTube <span aria-hidden="true">↗</span><span class="sr-only"> (new tab)</span></a>
            </div>
            {video.embed === 'unavailable' && <p class="embed-note">Watch this one on YouTube.</p>}
          </div>
        </article>;
      })}
    </div>

    <div class="library-empty" id="library-empty" hidden={videos.length > 0}>
      <p class="empty-label">The collection is taking shape</p>
      <h2>First selections coming soon.</h2>
      <p>Videos will appear here with topic tags, quick summaries, and links to the originals.</p>
    </div>
    <div class="library-empty" id="no-results" hidden>
      <h2>No videos match those filters.</h2>
      <p>Try a different topic or a broader search.</p>
      <button id="reset-search" class="watch-button" type="button">Show all videos</button>
    </div>
    {videos.length > 0 && <p class="library-footnote">Summaries describe each video’s content; inclusion isn’t an endorsement of every claim. Opening a player connects to YouTube.</p>}
  </section>

  <dialog id="video-dialog" aria-labelledby="player-title" aria-describedby="player-help">
    <div class="dialog-heading"><h2 id="player-title">Watch video</h2><button type="button" id="close-player" aria-label="Close video">Close <span aria-hidden="true">×</span></button></div>
    <div id="player-mount"></div>
    <div class="player-footer"><p id="player-help">If playback is restricted or the player won’t load, open the original on YouTube.</p><a id="player-youtube" target="_blank" rel="noopener noreferrer">Open YouTube <span aria-hidden="true">↗</span><span class="sr-only"> (new tab)</span></a></div>
  </dialog>
</Base>

<script>
  import '../scripts/youtube';
</script>

<style>
  .video-library { padding-block: 2.7rem 4rem; }
  .library-heading { display: flex; justify-content: space-between; gap: 1.5rem; align-items: end; padding-bottom: 1.75rem; }
  .library-kicker { margin: 0 0 .65rem; font-size: .875rem; font-weight: 600; color: var(--color-muted); }
  h1 { font-family: var(--serif); font-size: clamp(2.35rem, 5.5vw, 3.7rem); font-weight: 400; letter-spacing: -.045em; line-height: 1.1; margin: 0; }
  h1 span { color: #af6d2e; }
  .library-intro { margin: .9rem 0 0; max-width: 38rem; color: var(--color-muted); }
  .library-total { white-space: nowrap; margin: 0 0 .15rem; font-size: .875rem; color: var(--color-muted); }
  .library-total strong { font-size: 1.5rem; color: var(--green); font-weight: 500; }
  .library-controls { padding-block: 1.4rem; border-block: 1px solid var(--color-border); display: grid; grid-template-columns: minmax(0, 1fr) 190px 190px; gap: 1rem; }
  .library-controls label { display: block; font-size: .875rem; font-weight: 600; margin-bottom: .4rem; }
  .library-controls input, .library-controls select { width: 100%; min-width: 0; min-height: 48px; padding: .65rem .8rem; background: #fffefa; border: 1px solid #a6b2a7; border-radius: 4px; color: var(--green); font-size: 1rem; }
  .library-controls :disabled { opacity: .65; cursor: default; }
  .topic-filters { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: .5rem; }
  .topic-button { border: 1px solid var(--color-border); border-radius: 2rem; padding: .5rem 1rem; font-size: .875rem; min-height: 44px; cursor: pointer; background: transparent; }
  .topic-button[aria-pressed="true"] { background: var(--green); border-color: var(--green); color: white; }
  .topic-button:hover { border-color: var(--green); }
  .results-bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin: 1.25rem 0; font-size: .875rem; }
  .text-button { text-decoration: underline; text-underline-offset: .2em; cursor: pointer; min-height: 44px; }
  .video-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.4rem; align-items: start; }
  .video-card { border: 1px solid var(--color-border); border-radius: 6px; overflow: hidden; background: #fffefa; min-width: 0; scroll-margin-top: 1.5rem; }
  .thumbnail { display: block; aspect-ratio: 16 / 9; position: relative; overflow: hidden; background: #e0e5db; }
  .thumbnail img { width: 100%; height: 100%; object-fit: cover; }
  .duration { position: absolute; bottom: .65rem; right: .65rem; background: #102b24ed; color: white; padding: .1rem .4rem; border-radius: 3px; font-size: .8125rem; font-variant-numeric: tabular-nums; }
  .video-card-body { padding: 1.2rem; }
  .video-channel { font-size: .875rem; color: var(--color-muted); margin: 0 0 .35rem; }
  .video-card h2 { margin: 0; font-size: 1.2rem; line-height: 1.4; font-weight: 600; overflow-wrap: anywhere; }
  .video-card h2 a:hover { text-decoration: underline; }
  .video-topics { padding: 0; margin: .8rem 0 1rem; display: flex; flex-wrap: wrap; gap: .35rem .7rem; list-style: none; font-size: .8125rem; color: var(--color-muted); }
  .video-topics li { border-bottom: 1px solid var(--color-border); }
  .video-summary h3, .drew-context h3 { font-size: .875rem; font-weight: 700; margin: 0 0 .35rem; }
  .video-summary p, .drew-context p { margin: 0; }
  .video-notes { margin-top: 1rem; border-top: 1px solid var(--color-border); }
  .video-notes summary { cursor: pointer; padding: .8rem 0; min-height: 44px; font-size: .875rem; font-weight: 600; }
  .takeaways { list-style: disc; margin: .2rem 0 1rem; padding-left: 1.2rem; }
  .takeaways li + li { margin-top: .45rem; }
  .summary-source, .embed-note { font-size: .8125rem; color: var(--color-muted); margin: .8rem 0 0; }
  .summary-source a { text-decoration: underline; }
  .video-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .65rem 1rem; padding-top: 1.2rem; }
  .watch-button { min-height: 44px; padding: .55rem .9rem; border: 1px solid var(--green); border-radius: 4px; background: var(--green); color: white; cursor: pointer; font-size: .875rem; }
  .watch-button:hover { background: #235c48; }
  .video-actions a, .player-footer a { font-size: .875rem; text-decoration: underline; display: inline-flex; align-items: center; min-height: 44px; gap: .4rem; }
  .library-empty { padding: 3rem 1.5rem; margin-top: 1.6rem; border: 1px solid var(--color-border); border-left: 3px solid var(--green); border-radius: 3px; }
  .empty-label { font-size: .875rem; color: var(--color-muted); margin: 0 0 .75rem; }
  .library-empty h2 { font-family: var(--serif); font-size: clamp(1.7rem, 3vw, 2.25rem); line-height: 1.2; letter-spacing: -.03em; margin: 0 0 .8rem; font-weight: 400; }
  .library-empty p:last-child { color: var(--color-muted); max-width: 36rem; margin: 0; }
  .library-empty button { margin-top: 1rem; }
  .library-footnote { color: var(--color-muted); font-size: .875rem; max-width: 47rem; border-top: 1px solid var(--color-border); padding-top: 1.5rem; margin-top: 2.5rem; }
  dialog { position: fixed; inset: 0; width: min(960px, calc(100% - 24px)); max-height: calc(100dvh - 24px); overflow-y: auto; padding: 0; border: 1px solid #a6b2a7; border-radius: 6px; margin: auto; background: var(--paper); color: var(--green); }
  dialog::backdrop { background: #061d17ce; }
  .dialog-heading { display: flex; align-items: start; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem; }
  .dialog-heading h2 { margin: 0; font-size: 1.125rem; line-height: 1.5; overflow-wrap: anywhere; }
  #close-player { cursor: pointer; white-space: nowrap; min-height: 44px; padding: .4rem .6rem; border: 1px solid var(--color-border); border-radius: 4px; font-size: .875rem; }
  #player-mount { aspect-ratio: 16 / 9; min-height: 200px; background: #091b16; }
  #player-mount :global(iframe) { width: 100%; height: 100%; min-height: 200px; border: 0; display: block; aspect-ratio: 16 / 9; }
  .player-footer { padding: 1rem 1.25rem; }
  .player-footer p { font-size: .875rem; margin: 0; color: var(--color-muted); }
  @media (max-width: 950px) { .video-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .library-controls { grid-template-columns: repeat(2, minmax(0, 1fr)); } .search-field { grid-column: 1 / -1; } }
  @media (max-width: 600px) { .video-library { padding-top: 2rem; } .library-heading { align-items: start; flex-direction: column; gap: .65rem; } .video-grid { grid-template-columns: 1fr; } .library-controls { gap: .8rem; } .library-controls select { padding-inline: .5rem; } .library-empty { padding: 2rem 1.2rem; } .dialog-heading { padding: .8rem; } .player-footer { padding: .8rem; } }
  @media (max-width: 359px) { .library-controls { grid-template-columns: 1fr; } }
</style>
