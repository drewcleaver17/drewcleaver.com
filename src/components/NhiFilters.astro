---
import {categories,topics,regions,evidenceDefinitions} from '../lib/ufos.mjs';
import NhiThemeControl from './NhiThemeControl.astro';
const groups=[
  {key:'topic',label:'Topics',hint:'The historical subject: what an entry is about.',options:topics.map(v=>[v,v])},
  {key:'category',label:'Categories',hint:'The kind of event or record, such as research or a hearing.',options:categories.map(v=>[v,v])},
  {key:'evidence',label:'Evidence types',hint:'What kind of evidence supports the entry; not a confidence score.',options:Object.keys(evidenceDefinitions).map(v=>[v,v])},
  {key:'region',label:'Regional collections',hint:'Four curated regional collections; this is not a complete country filter.',options:Object.entries(regions)},
  {key:'layer',label:'Timeline layers',hint:'Core UFO records and broader historical context.',options:[['core','Core UFO timeline'],['contextual','Contextual history']]}
];
---
<form id="timeline-filters" class="filter-panel" role="search" aria-label="Search and filter timeline" hidden tabindex="-1">
  <div class="filter-essentials">
    <h3>Shape your timeline</h3>
    <label class="search-field">Search entries & source titles<input name="q" type="search" placeholder="Try Phoenix, Leavitt, evolution…" autocomplete="off" /></label>
    <button type="button" id="clear-search" class="underlined">Clear search</button>
    <a href="#results-summary" class="underlined" data-results-jump>Skip to results ↓</a>
    <p class="search-scope">Choose one or more. Match any choice in a group; different groups narrow results together. Checkboxes apply immediately; search updates after a short pause.</p>
    <nav class="filter-jumps" aria-label="Filter groups"><a href="#date-range">Date range</a>{groups.map(g=><a href={`#choices-${g.key}`}>{g.label}</a>)}<a href="#choices-entity">People and subjects</a><a href="#filter-display">View & order</a></nav>
    <p id="url-notice" class="search-scope" hidden></p>
  </div>
  <div class="filter-options">
    <fieldset id="date-range" class="filter-group" aria-describedby="date-help date-status">
      <legend>Date range</legend>
      <p id="date-help" class="search-scope">Use whole years; blank means no limit. Matches each entry’s timeline date, including overlapping spans. Approximate dates keep their uncertainty.</p>
      <div class="date-bounds">{['from','to'].map(key=><div class="date-bound"><label>{key==='from'?'From year':'To year'}<input name={key} type="text" inputmode="numeric" autocomplete="off" aria-describedby={`${key}-error`} /></label><label>{key==='from'?'From era':'To era'}<select name={`${key}Era`}><option>CE</option><option>BCE</option></select></label><p id={`${key}-error`} class="date-error" hidden></p></div>)}</div>
      <div class="filter-actions"><button type="button" id="apply-date" class="button button-outline">Apply date range</button><button type="button" id="clear-date" class="underlined">Clear date range</button></div>
      <label>Quick range<select id="date-preset"><option value="">Custom / any date</option></select></label>
      <p id="date-summary" class="range-summary">Any date</p><p id="date-status" class="search-scope" role="status"></p>
      <p class="search-scope">A date range excludes undated entries. Deep-time ages use the index’s disclosed ordering estimates.</p>
    </fieldset>
    {groups.map(g=><fieldset id={`choices-${g.key}`} class="filter-group" data-facet={g.key} aria-describedby={`hint-${g.key}`}><legend>{g.label}</legend><p class="search-scope" id={`hint-${g.key}`}>{g.hint}</p><div class="facet-heading"><span data-selection-summary={g.key}>Any choice</span><button type="button" data-clear-facet={g.key} class="underlined">Clear {g.label.toLowerCase()}</button></div><div class="choice-list">{g.options.map(([value,label])=><label class="choice"><input type="checkbox" name={g.key} value={value} data-choice-for={g.key}/><span>{label}</span><span class="option-count" aria-label="Matching entries" data-count-for={g.key} data-value={value}></span></label>)}</div></fieldset>)}
    <fieldset id="choices-entity" class="filter-group" data-facet="entity" aria-describedby="entity-help"><legend>People and subjects</legend><p id="entity-help" class="search-scope">Find a person, organization, program, place, or other named subject. This filters related timeline entries. Profile links open separately.</p><label>Find names or subjects<input type="search" id="entity-search" autocomplete="off" placeholder="Name or verified alias…"/></label><button type="button" id="clear-entity-search" class="underlined">Clear name search</button><div class="facet-heading"><span data-selection-summary="entity">Any choice</span><button type="button" data-clear-facet="entity" class="underlined">Clear people and subjects</button></div><div id="selected-entities" aria-label="Selected people and subjects"></div><p id="entity-match-count" class="search-scope" role="status"></p><div id="entity-choices" class="choice-list"></div><button type="button" id="more-entities" class="underlined">Show more</button></fieldset>
    <p class="search-scope">Option counts match all your other filters plus that choice, ignoring choices already in the same group. They are not the number of extra entries you would add. Zero-count choices stay selectable.</p>
    <div id="filter-display" class="filter-group"><h4>View & order</h4><label>View<select name="view"><option value="journey">Main reading path · all eras</option><option value="story">Modern disclosure · 2017+</option><option value="core">Core timeline · all eras</option><option value="history">Full history & context</option><option value="institutions">Institutional history</option><option value="recent">Recently added or corrected</option></select></label><label>Order<select name="sort"><option value="oldest">Oldest first</option><option value="newest">Newest first</option></select></label><label class="checkbox-label"><input name="context" type="checkbox"/>Include supporting context in a reading path</label><p class="search-scope">Timeline filters stay separate from the People and Institutions directories. Global search covers entry text, verified aliases and source titles, not full source documents.</p></div>
    <div class="filter-actions"><button type="reset" class="underlined">Clear all filters</button><button type="button" data-copy-view class="underlined">Copy filtered view</button><a href="#results-summary" data-results-jump class="underlined">View results ↓</a><a href="#results-summary" id="return-reading" class="underlined" hidden>Return to reading ↓</a></div><NhiThemeControl />
  </div>
</form>
