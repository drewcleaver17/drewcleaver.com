---
import { groups, fields, reference, calculate, metrics, formatMetric, number } from '../lib/metsi-model.mjs';
import { profile } from '../data/profile';
const result = calculate(reference);
const visible = new Set(['revenue','costs','surplus','margin','cashAfterDebt','breakEvenMembers','targetMembers','routineCapacity','utilization','safeMembers']);
const names=['Reference model','Garrick’s inputs','Proposed scenario'];
---
<section class="model-section" id="model" aria-labelledby="model-title" data-metsi-tool data-email={profile.email}>
 <div class="model-shell">
  <p class="model-eyebrow">A working model for our next conversation</p>
  <div class="model-heading"><h2 id="model-title">Put your numbers<br />into the picture.</h2><p>Keep the reference. Add what you know. Explore what could change. Every result below updates as you edit the assumptions.</p></div>
  <noscript><p class="model-alert">Enable JavaScript to edit and save scenarios. The reference figures and original concept remain readable below.</p></noscript>
  <div class="tool-controls" data-enhanced hidden>
   <div class="discussion-meta"><label>Discussion name<input data-meta="name" value="METSI Care discussion" maxlength="200" /></label><label>Prepared by<input data-meta="author" placeholder="Name or initials (optional)" maxlength="200" /></label></div>
   <p class="model-small">The two editable columns start with the reference assumptions, <strong>not actual practice data</strong>. Change the basis and reporting period when you enter your own figures. All amounts are USD.</p>
   <div class="scenario-meta">
    {[0,1].map((i)=><fieldset><legend>{names[i+1]}</legend><label>Column name<input data-scenario-meta="name" data-scenario={i} value={names[i+1]} maxlength="100" /></label><div class="meta-pair"><label>Basis<select data-scenario-meta="basis" data-scenario={i}>{['Reference assumptions','Ballpark estimates','Actuals and estimates','Actual practice figures'].map(x=><option>{x}</option>)}</select></label><label>Reporting period<input data-scenario-meta="period" data-scenario={i} placeholder="e.g. 2026 run rate" maxlength="100" /></label></div></fieldset>)}
   </div>
   <div class="tool-actions compact-actions"><button type="button" data-action="copy-current">Copy Garrick’s inputs into proposed</button><a href="#assumptions">Edit assumptions ↓</a><a href="#save-model">Save or export ↓</a></div>
  </div>
  <div class="results-wrap" id="model-results">
   <table class="model-results"><caption>Annual economics and monthly care capacity</caption><thead><tr><th scope="col">Result</th>{names.map((n,i)=><th scope="col" data-column-name={i-1}>{n}</th>)}</tr></thead><tbody>{metrics.filter(([k])=>visible.has(k)).map(([key,label,type])=><tr class:list={{'result-emphasis':['surplus','margin'].includes(key)}}><th scope="row">{label}</th>{[0,1,2].map(i=><td data-result={key} data-result-column={i} data-label={names[i]}>{formatMetric(result[key],type)}</td>)}</tr>)}</tbody></table>
   <p class="comparison-delta" data-comparison>Both editable columns currently match the reference.</p>
  </div>
  <details class="model-detail results-detail"><summary>More results: staffing, prepayments, startup and the network</summary><table class="model-results"><caption>Additional calculated results</caption><thead><tr><th scope="col">Result</th>{names.map((n,i)=><th scope="col" data-column-name={i-1}>{n}</th>)}</tr></thead><tbody>{metrics.filter(([k])=>!visible.has(k)).map(([key,label,type])=><tr><th scope="row">{label}</th>{[0,1,2].map(i=><td data-result={key} data-result-column={i} data-label={names[i]}>{formatMetric(result[key],type)}</td>)}</tr>)}</tbody></table></details>
  <div class="model-checks" data-enhanced hidden aria-label="Scenario checks">{[0,1].map(i=><div><h3 data-check-title={i}>{names[i+1]}: items to resolve</h3><ul data-warnings={i}></ul></div>)}</div>
  <p class="model-alert" data-validation role="status" hidden></p>
  <div class="assumption-heading" id="assumptions"><p class="model-eyebrow">The assumptions</p><h3>Adjust one thing. See what moves.</h3><p>Reference values stay fixed. Each column has its own assumptions. Blank optional costs mean “not supplied.” Salary inputs are annual amounts, even when working hours change.</p></div>
  <div data-input-groups>{groups.map((g,gi)=><details class="model-detail input-group" open={gi===0}><summary><span>{String(gi+1).padStart(2,'0')} / {g.name}</span><span class="field-count">{g.fields.length} inputs</span></summary><p class="group-note">{g.note}</p><div class="input-column-headings" aria-hidden="true"><span>Assumption</span><span>Reference</span><span data-column-name="0">Garrick’s inputs</span><span data-column-name="1">Proposed scenario</span></div>{g.fields.map(f=><div class="assumption-row"><div class="assumption-description"><span class="assumption-label" id={`label-${f.key}`}>{f.label}</span><span class="assumption-unit" id={`unit-${f.key}`}>{f.unit}</span>{f.help&&<p id={`help-${f.key}`}>{f.help}</p>}</div><div class="reference-value"><span>Reference</span>{f.value===null?'Not supplied':number(f.value)}</div>{[0,1].map(i=><label class="assumption-input"><span data-column-name={i}>{names[i+1]}</span><input type="number" inputmode={f.step===1?'numeric':'decimal'} id={`input-${i}-${f.key}`} data-input={f.key} data-scenario={i} value={f.value??''} min={f.min} max={f.max} step={f.step} placeholder={f.nullable?'Not supplied':undefined} aria-label={`${f.label}: ${names[i+1]}`} aria-describedby={`unit-${f.key}${f.help?' help-'+f.key:''}`} disabled /><span class="input-error" data-error={`${i}-${f.key}`} hidden></span></label>)}</div>)}<p class="inline-results" data-inline-summary></p><p><a href="#model-results">View updated comparison ↑</a></p></details>)}</div>
  <div class="model-assumptions-note"><h3>What the calculations include</h3><p>Membership revenue reflects tier mix and annual discounts. Paid extra visits add revenue and consume routine capacity. The smaller of the daily visit cap and available appointment time limits capacity. Protected urgent and administrative hours remain separate.</p><p>Operating surplus includes owner pay, employment costs and the platform fee. Cash after debt service also deducts principal and interest payments. Taxes, replacement equipment, changes in working capital and unentered costs remain outside that cash figure. Extra visits assume no costs beyond those you enter.</p><p>The network view multiplies mature practices; it does not forecast opening speed. Combined surplus adds practice and platform results, counting the platform fee only once. Pilot dues are a prorated revenue illustration, not pilot profit. These calculations do not establish a clinically safe panel size.</p></div>
  <div class="review-section" id="save-model" data-enhanced hidden>
   <p class="model-eyebrow">Save the conversation, not just the numbers</p><h3>Bring the next version back.</h3>
   <div class="scenario-notes">{[0,1].map(i=><label><span data-notes-label={i}>{names[i+1]}: sources and notes</span><textarea data-scenario-meta="notes" data-scenario={i} rows="4" placeholder="Which figures are actual? Which need checking? What changed?" maxlength="20000"></textarea></label>)}</div>
   <label class="feedback-label">Questions, feedback and ideas for Drew<textarea data-meta="feedback" rows="5" placeholder="What feels right? What is missing? What should we test next?" maxlength="20000"></textarea></label>
   <p class="save-status" data-save-status role="status">Autosave will start after your first change.</p>
   <p class="model-small">Autosave and named copies stay in <strong>this browser on this device</strong>. They do not sync or send anything to Drew. Export a review file to back up your work, move devices or send a revision. Keep patient information out of the notes.</p>
   <div class="save-row"><button type="button" data-action="save-copy">Save a named copy</button><label>Saved comparisons<select data-saved-select><option value="">Choose a saved copy</option></select></label><button type="button" data-action="load-copy">Load copy</button><button type="button" data-action="delete-copy">Delete copy</button></div>
   <div class="tool-actions"><button class="primary-action" type="button" data-action="export-json">Download review file (.json)</button><button type="button" data-action="export-csv">Export comparison (.csv)</button><button type="button" data-action="export-text">Download readable summary</button><label class="import-button">Import a review file<input type="file" data-import accept=".json,application/json" /></label><button type="button" data-action="copy-summary">Copy summary</button><a data-email-draft href={`mailto:${profile.email}?subject=METSI%20Care%20model%20feedback`}>Email Drew</a></div>
   <p class="model-small">Download the review file and attach it to your email to <a href={`mailto:${profile.email}`}>{profile.email}</a>. It includes both input sets, the reference, calculated results and all feedback. Importing it restores the editable comparison; results are recalculated.</p>
   <p class="action-status" data-action-status role="status"></p><textarea class="copy-fallback" data-copy-fallback readonly aria-label="Summary to copy" hidden></textarea>
   <div class="reset-actions"><button type="button" data-action="reset-current">Reset Garrick’s inputs</button><button type="button" data-action="reset-proposed">Reset proposed scenario</button></div>
  </div>
  <details class="model-detail formula-detail"><summary>Calculation notes and model version</summary><p>Revenue = members × blended monthly price × (1 − annual-payment share × discount) × 12 + paid extra visits. Employment costs = physician cash pay × burden rate + fixed adjustment.</p><p>Monthly routine capacity = the sum, by role, of days per week × working weeks × the smaller of the daily visit cap and available minutes ÷ weighted calendar block, divided by 12. Extra visits consume their entered block lengths. The access target limits the modeled enrollment cap.</p><p>Break-even members and members needed for the margin target round up. Members within the access target round down. Zero revenue, zero capacity and missing startup or platform costs show unavailable results instead of invented zeros.</p><p>Model: metsi-2026-09-v1. The original narrative and downloadable slide deck below retain their reference assumptions; editing this tool does not rewrite them.</p></details>
 </div>
</section>
<script>
 import { initializeMetsiModel } from '../scripts/metsi-calculator.js';
 initializeMetsiModel();
</script>
<style>
 .model-section{background:#f7f5ee;color:#203d34;padding:4rem 0;border-bottom:1px solid #d1d6ca;scroll-margin-top:1rem}.model-shell{width:min(1160px,calc(100% - 48px));margin:auto;min-width:0}.model-eyebrow{font-size:.8rem;letter-spacing:.12em;font-weight:650;text-transform:uppercase;color:#235c48;margin:0 0 1rem}.model-heading{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:3rem;margin-bottom:2rem}.model-heading h2{font-family:Georgia,serif;font-weight:400;font-size:clamp(2.4rem,5vw,4rem);letter-spacing:-.04em;line-height:1.07;margin:0}.model-heading p{max-width:31rem;margin:0;font-size:1.1rem;line-height:1.7}.model-small{font-size:.9rem;line-height:1.65;margin:1rem 0;color:#53665a}.discussion-meta,.scenario-meta,.scenario-notes{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}.discussion-meta{margin-bottom:1.25rem}.model-section label{display:block;font-size:.9rem;line-height:1.4;font-weight:600}.model-section input,.model-section select,.model-section textarea{display:block;width:100%;min-width:0;margin-top:.45rem;padding:.7rem .75rem;font:inherit;font-weight:400;font-size:1rem;color:#173e35;background:#fffefa;border:1px solid #a7b7a5;border-radius:3px;min-height:46px}.model-section textarea{resize:vertical;line-height:1.55}.model-section input:disabled{opacity:.65}.model-section fieldset{min-width:0;border:1px solid #bbc7b6;padding:1rem 1.1rem 1.2rem}.model-section legend{font-size:1rem;padding:0 .4rem;font-weight:650}.meta-pair{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:.8rem}.tool-actions{display:flex;flex-wrap:wrap;gap:.7rem;margin:1.2rem 0}.tool-actions a,.model-section button,.import-button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:.65rem .9rem;border:1px solid #a7b7a5;border-radius:3px;background:transparent;font-size:.9rem;line-height:1.4;text-decoration:none;color:#173e35;cursor:pointer}.tool-actions a:hover,.model-section button:hover,.import-button:hover{background:#e7eddf}.model-section button.primary-action{background:#173e35;color:#f7f5ee;border-color:#173e35}.model-section button.primary-action:hover{background:#235c48}.model-section :focus-visible{outline:3px solid #af6d2e;outline-offset:4px}.model-results{width:100%;border-collapse:collapse;table-layout:fixed;margin:0}.model-results caption{font-size:.85rem;text-align:left;color:#53665a;padding:1rem 0}.model-results th,.model-results td{padding:.95rem .8rem;border-bottom:1px solid #cbd4c4;text-align:right;line-height:1.4;font-size:1rem;vertical-align:middle;overflow-wrap:anywhere;font-variant-numeric:tabular-nums}.model-results th:first-child{width:37%;text-align:left;font-weight:500}.model-results thead th{background:#173e35;color:#f7f5ee;font-size:.85rem;font-weight:600}.model-results tbody tr:nth-child(even){background:#edf0e6}.model-results .result-emphasis{background:#dfe8d6!important}.model-results .result-emphasis th,.model-results .result-emphasis td{font-weight:700}.comparison-delta{padding:1rem;background:#173e35;color:#f7f5ee;margin:0;font-size:1rem}.model-detail{border:1px solid #bbc7b6;margin-top:1rem;padding:0 1rem;background:#fffefa50}.model-detail>summary{cursor:pointer;min-height:58px;padding:1rem 0;font-size:1rem;font-weight:650;line-height:1.5}.model-detail>p{font-size:.94rem;line-height:1.65;margin:0 0 1.2rem}.results-detail{padding:0}.results-detail>summary{padding:1rem}.results-detail caption{padding-inline:1rem}.model-checks{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin:1.5rem 0}.model-checks h3{font-size:1rem;line-height:1.4;margin:0 0 .65rem;font-weight:650}.model-checks ul{list-style:disc;padding-left:1.2rem;margin:0}.model-checks li{font-size:.9rem;line-height:1.65;margin:.35rem 0}.model-alert{padding:1rem;border:1px solid #a8793b;background:#f5ead8;line-height:1.55}.assumption-heading{margin-top:3rem;scroll-margin-top:1.5rem}.assumption-heading h3,.review-section>h3{font-family:Georgia,serif;font-size:2.2rem;font-weight:400;line-height:1.2;margin:0 0 1rem}.assumption-heading p{max-width:48rem}.input-group>summary{display:flex;align-items:center;gap:1rem;justify-content:space-between;list-style:none}.input-group>summary::before{content:'+';font-size:1.4rem;font-weight:400}.input-group[open]>summary::before{content:'−'}.input-group>summary>span:first-child{flex:1}.field-count{font-size:.82rem;color:#53665a;white-space:nowrap}.input-column-headings,.assumption-row{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,.8fr) minmax(0,1fr) minmax(0,1fr);gap:1.2rem;align-items:start}.input-column-headings{padding:.8rem 0;background:#edf0e6;font-size:.8rem;font-weight:650}.assumption-row{padding:1rem 0;border-top:1px solid #d1d6ca}.assumption-label{font-weight:650;display:block;line-height:1.4}.assumption-unit{font-size:.85rem;color:#53665a;display:block;margin-top:.3rem}.assumption-description p{font-size:.82rem;line-height:1.55;color:#53665a;margin:.45rem 0 0}.reference-value{font-size:1rem;font-variant-numeric:tabular-nums;padding-top:.9rem}.reference-value>span{display:none}.assumption-input>span:first-child{display:none}.assumption-input input{margin:0;font-variant-numeric:tabular-nums}.input-error{font-size:.8rem;color:#765121;font-weight:500;line-height:1.4}.assumption-input input[aria-invalid=true]{border:2px solid #9a6a2d}.model-assumptions-note{border-left:3px solid #719367;padding:0 0 0 1.3rem;margin:2rem 0;max-width:60rem}.model-assumptions-note h3{font-weight:650;font-size:1rem}.model-assumptions-note p{font-size:.9rem;line-height:1.7}.review-section{margin:3rem 0 2rem;border-top:2px solid #173e35;padding-top:2rem;scroll-margin-top:1.5rem}.feedback-label{margin:1.25rem 0}.save-status{font-size:.9rem;font-weight:600}.save-row{display:flex;gap:.7rem;flex-wrap:wrap;align-items:end;margin:1.25rem 0}.save-row label{flex:1 1 250px}.import-button{position:relative;overflow:hidden;margin:0;font-weight:400!important}.import-button input{position:absolute;opacity:0;width:100%;height:100%;inset:0;margin:0;cursor:pointer}.import-button:focus-within{outline:3px solid #af6d2e;outline-offset:4px}.action-status{font-weight:600;font-size:.94rem;line-height:1.6}.copy-fallback{height:220px}.reset-actions{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.2rem}.reset-actions button{font-size:.85rem;border:0;text-decoration:underline;padding-inline:0}.formula-detail{margin-top:2rem}
 @media(max-width:760px){.model-shell{width:calc(100% - 32px)}.model-section{padding:2.5rem 0}.model-heading{grid-template-columns:1fr;gap:1.2rem}.model-heading h2 br{display:none}.discussion-meta,.scenario-meta,.scenario-notes,.model-checks{grid-template-columns:1fr;gap:1rem}.meta-pair{grid-template-columns:1fr}.model-results thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}.model-results,.model-results tbody{display:block}.model-results tr{display:block;border-bottom:1px solid #cbd4c4;padding:.8rem}.model-results th:first-child{display:block;width:100%;border:0;padding:0 0 .65rem;font-size:1rem;font-weight:650}.model-results td{display:flex;justify-content:space-between;gap:1rem;border:0;padding:.25rem 0;font-size:.95rem;text-align:right}.model-results td::before{content:attr(data-label);text-align:left;color:#53665a;font-weight:400;max-width:60%}.model-results caption{display:block}.input-column-headings{display:none}.assumption-row{grid-template-columns:1fr 1fr;gap:.8rem}.assumption-description{grid-column:1/-1}.reference-value{grid-column:1/-1;padding:0;font-size:.9rem}.reference-value>span{display:inline;margin-right:.65rem;color:#53665a}.assumption-input>span:first-child{display:block;font-size:.8rem;font-weight:500;color:#53665a;margin-bottom:.35rem}.model-detail{padding-inline:.85rem}.results-detail{padding:0}.tool-actions>*{flex:1 1 180px}.field-count{display:none}.model-checks{padding:1rem 0}.scenario-meta fieldset{padding:.8rem}.compact-actions a{flex:1 1 120px}}
 @media(max-width:380px){.assumption-row{grid-template-columns:1fr}.assumption-input{grid-column:1/-1}.model-results td{font-size:.9rem}.model-shell{width:calc(100% - 28px)}}
 @media print{.model-section{padding:1rem 0}.tool-actions,.save-row,.reset-actions,.save-status,.import-button,[data-email-draft]{display:none!important}.model-heading{display:block}.model-detail{break-inside:avoid}.model-results tr{break-inside:avoid}.model-shell{width:100%}}
</style>
