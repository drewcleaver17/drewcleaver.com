---
import {groups,newState,calculateWorksheet,calculateLaunchWorksheet,metrics,launchMetrics,monthlyColumns,formatMetric,bases,notes,MODEL_VERSION} from '../lib/dpc-worksheet.mjs';
import {profile} from '../data/profile';
const initial=newState(),mature=calculateWorksheet(initial.worksheet),launch=calculateLaunchWorksheet(initial.worksheet);
const networkKeys=new Set(['networkRevenue','platformRevenue','platformSurplus','combinedSurplus']);
const groupNotes=['Illustrative starting figures. Every value is editable, including zero or empty.','Calendar blocks determine capacity. Protected urgent time and follow-up stay separate.','Annual compensation does not automatically change when working hours change.','Enter each cost once. Empty means unknown; zero means none.','Practice revenue and platform revenue belong to different businesses.','These are proposed targets and planning assumptions, not measured results.','Month 1 is the first planning month. Hiring, enrollment and opening can begin at different times.','Startup spending happens once. Cash already available and financing are separate funding sources.'];
---
<section class="worksheet" id="model" data-dpc-worksheet data-email={profile.email} aria-labelledby="worksheet-title"><div class="worksheet-shell">
 <p class="eyebrow">One working model</p><h2 id="worksheet-title">Your assumptions.<br />One clear picture.</h2>
 <p class="intro">Edit the prefilled figures, leave unknowns blank, and add anything missing. All sections are open. The results update from this single worksheet.</p>
 <p class="small">The starting figures are illustrative. <strong>Zero means none. Empty means unknown.</strong> You can save and export an unfinished worksheet; dependent results remain incomplete. Amounts are USD unless a reference row specifies another unit.</p>
 <noscript><p class="notice">Enable JavaScript to edit, add rows, calculate and save. The prefilled assumptions and reference results remain readable.</p></noscript>
 <nav class="actions" aria-label="Worksheet sections"><a href="#assumptions">Edit assumptions</a><a href="#custom-rows">Add a row</a><a href="#model-results">Practice results</a><a href="#launch-results">Monthly launch</a><a href="#network-results">Network</a><a href="#save-model">Save / send feedback</a></nav>
 <div class="metadata"><label>Discussion name<input data-meta="name" value={initial.name} /></label><label>Prepared by<input data-meta="author" placeholder="Name or initials (optional)" /></label><label>Worksheet name<input data-sheet-meta="name" value={initial.worksheet.name} /></label><label>Reporting period<input data-sheet-meta="period" placeholder="e.g. 2026 run rate" /></label><label>Basis of practice figures<select data-sheet-meta="basis">{bases.map(x=><option>{x}</option>)}</select></label><label>Basis of launch figures<select data-sheet-meta="launchBasis">{bases.map(x=><option>{x}</option>)}</select></label></div>
 <p class="notice" data-migration hidden></p><p class="notice" data-validation role="status" hidden></p>
 <section id="assumptions" class="assumptions" aria-labelledby="assumptions-title"><h3 id="assumptions-title">Edit the assumptions</h3>{groups.map((g,gi)=><section class="input-group" aria-labelledby={`group-${gi}`}><h4 id={`group-${gi}`}>{String(gi+1).padStart(2,'0')} / {g.name}</h4><p class="small">{groupNotes[gi]}</p>{g.fields.map(f=><div class="assumption-row"><label for={`input-${f.key}`}><span class="field-name">{f.label}</span><span class="unit" id={`unit-${f.key}`}>{f.unit}</span>{f.help&&<span class="help" id={`help-${f.key}`}>{f.help}</span>}</label><div class="value-cell"><input type="number" id={`input-${f.key}`} data-input={f.key} value={f.value??''} min={f.min} max={f.max} step={f.step} inputmode={f.step===1?'numeric':'decimal'} placeholder="Unknown" aria-describedby={`unit-${f.key}${f.help?' help-'+f.key:''}`} disabled /><span class="field-error" data-error={f.key} hidden></span></div></div>)}</section>)}</section>
 <section id="custom-rows" class="part"><p class="eyebrow">Anything missing?</p><h3>Add your own rows</h3><p>Add a category, description and optional value. Leave “Reference only” selected for a note, count, percentage or other figure. Select a financial use to include an amount in the calculations.</p><p class="small">Recurring practice expenses start in the local-cost month; recurring income starts when care opens. Annual amounts are divided by 12. One-time expenses use the startup spending month. Platform rows are annual amounts for the entire network. Use the existing platform fee for internal transfers. Added income does not create appointment capacity.</p><div data-custom-rows></div><p data-no-custom class="small">No added rows yet. A row can contain text only, a number, zero or a dollar amount.</p><button type="button" data-action="add-row" disabled>+ Add a row</button></section>
 <section class="part" id="model-results"><p class="eyebrow">Calculated from your worksheet</p><h3>Mature practice</h3><p class="small" data-results-name>{initial.worksheet.name}</p><table class="results"><caption>Annual economics and monthly capacity</caption><thead><tr><th>Result</th><th>Your model</th></tr></thead><tbody>{metrics.filter(([k])=>!networkKeys.has(k)).map(([key,label,type])=><tr class:list={{emphasis:['surplus','margin'].includes(key)}}><th scope="row">{label}</th><td data-result={key}>{formatMetric(mature[key],type)}</td></tr>)}</tbody></table></section>
 <section class="part" id="launch-results"><h3>Launch and enrollment</h3><p>Prices, staffing, costs and added financial rows feed this monthly view. Empty startup spending or opening cash keeps the dependent cash results incomplete.</p><table class="results"><caption>Launch results for your planning horizon</caption><thead><tr><th>Result</th><th>Your model</th></tr></thead><tbody>{launchMetrics.map(([key,label,type])=><tr><th scope="row">{label}</th><td data-launch-result={key}>{formatMetric(launch[key],type)}</td></tr>)}</tbody></table><p class="small">Break-even and cash recovery must hold through the remaining horizon. “Not reached / incomplete” means the milestone is not reached or an input is missing. Reserve funding is an alternative total gap, not an amount to add again to the minimum funding gap.</p><p class="notice" data-launch-incomplete hidden></p>
 <div class="chart-grid"><figure><figcaption>Earned revenue and operating costs</figcaption><svg data-chart="operations" role="img" aria-label="Monthly earned revenue and operating costs" viewBox="0 0 360 230"></svg><p class="small">Solid green: earned revenue · dashed bronze: costs</p></figure><figure><figcaption data-cash-chart-title>Operating cash before startup or financing</figcaption><svg data-chart="cash" role="img" aria-label="Monthly cash view" viewBox="0 0 360 230"></svg><p class="small" data-cash-chart-note></p></figure></div>
 <h4>Every month and cash movement</h4><p class="small">The full table is always open. Swipe horizontally for more columns on a phone. JSON, CSV and readable exports include every month. Fractional members are expected values.</p><div class="monthly-scroll" tabindex="0" role="region" aria-label="Monthly launch figures, scroll horizontally"><table class="monthly-table"><caption data-monthly-caption>Monthly launch detail</caption><thead><tr>{monthlyColumns.map(([,label])=><th scope="col">{label}</th>)}</tr></thead><tbody data-monthly-body></tbody></table></div></section>
 <section class="part" id="network-results"><h3>Mature network and support company</h3><p class="small">This multiplies equally mature practices rather than forecasting openings. The platform fee cancels in combined surplus. Added platform income is assumed external.</p><table class="results"><caption>Annual network results</caption><thead><tr><th>Result</th><th>Your model</th></tr></thead><tbody>{metrics.filter(([k])=>networkKeys.has(k)).map(([key,label,type])=><tr><th scope="row">{label}</th><td data-result={key}>{formatMetric(mature[key],type)}</td></tr>)}</tbody></table></section>
 <section class="part checks"><h3>Items to resolve</h3><ul data-warnings></ul></section>
 <section class="part review-section" id="save-model"><p class="eyebrow">Keep the conversation moving</p><h3>Save your inputs and feedback</h3><label>Sources and notes<textarea data-sheet-meta="notes" rows="4" placeholder="Which figures are actual? What needs checking?"></textarea></label><label>Questions, feedback and ideas for Drew<textarea data-meta="feedback" rows="5"></textarea></label><p class="save-status" data-save-status role="status">Autosave starts after your first change.</p><p class="small">Autosave and saved copies stay in this browser on this device. Nothing is automatically sent. Download a review file for a backup or to send Drew. Keep patient information out of the worksheet.</p>
 <div class="saved-controls"><button type="button" data-action="save-copy" disabled>Save a named copy</button><label>Saved worksheets<select data-saved-select><option value="">Choose a saved copy</option></select></label><button type="button" data-action="load-copy" disabled>Load copy</button><button type="button" data-action="delete-copy" disabled>Delete copy</button></div>
 <div class="earlier-controls"><h4>Earlier inputs</h4><p class="small">Older comparisons retain both columns as separate worksheets. Open one at a time. Switching keeps the current worksheet here, and exports include all retained worksheets.</p><label>Retained worksheets<select data-earlier-select><option value="">No earlier worksheet retained</option></select></label><button type="button" data-action="open-earlier" disabled>Open selected worksheet</button></div>
 <div class="actions"><button type="button" class="primary" data-action="export-json" disabled>Download review file (.json)</button><button type="button" data-action="export-csv" disabled>Export worksheet (.csv)</button><button type="button" data-action="export-text" disabled>Download readable summary</button><label class="import-control">Import a review file<input type="file" data-import accept=".json,application/json" disabled /></label><button type="button" data-action="copy-summary" disabled>Copy summary</button><a data-email-draft href={`mailto:${profile.email}?subject=Direct%20Primary%20Care%20worksheet`}>Email Drew</a></div><p class="small">The email button opens a draft. Download the JSON file and attach it yourself. Imports restore the inputs and recalculate results, including incomplete worksheets and custom rows. The PDF remains a dated reference.</p><p data-action-status class="action-status" role="status"></p><textarea data-copy-fallback readonly aria-label="Summary to copy" hidden></textarea><div class="actions"><button type="button" data-action="restore-defaults" disabled>Restore prefilled figures</button></div></section>
 <section class="part definitions"><h3>Calculation notes</h3>{notes.map(note=><p>{note}</p>)}<p>Model: {MODEL_VERSION}. All 70 prefilled assumptions are retained. The reference narrative and PDF are unchanged by your edits.</p></section>
</div></section>
<script>import {initializeDpcWorksheet} from '../scripts/dpc-calculator.js';initializeDpcWorksheet();</script>
<style>
 .worksheet{background:#f7f5ee;color:#173e35;padding:4rem 0;border-block:1px solid #d1d6ca}.worksheet-shell{width:min(940px,calc(100% - 40px));margin:auto;min-width:0}.worksheet [hidden]{display:none!important}.eyebrow{font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;font-weight:650;color:#235c48;margin:0 0 1rem}.worksheet h2{font:400 clamp(2.4rem,5vw,4rem)/1.08 Georgia,serif;letter-spacing:-.035em;margin:0 0 1.3rem}.worksheet h3{font:400 clamp(1.8rem,3.4vw,2.4rem)/1.2 Georgia,serif;margin:0 0 1.2rem}.worksheet h4{font-size:1.1rem;line-height:1.5;margin:0 0 1rem}.worksheet p{line-height:1.7;margin:1rem 0}.intro{font-size:1.15rem;max-width:45rem}.worksheet .small,.definitions p{font-size:.9rem;color:#53665a;line-height:1.65}.actions{display:flex;flex-wrap:wrap;gap:.65rem;margin:1.5rem 0}.worksheet button,.actions a,.import-control{min-height:46px;display:inline-flex;align-items:center;justify-content:center;padding:.65rem .9rem;border:1px solid #a7b7a5;background:#fffefa;color:#173e35;text-decoration:none;font:inherit;font-size:.9rem;line-height:1.4;cursor:pointer;border-radius:3px}.worksheet button:hover,.actions a:hover{background:#e6eddf}.worksheet button.primary{background:#173e35;color:#f7f5ee}.worksheet button:disabled{opacity:.6;cursor:default}.worksheet :focus-visible{outline:3px solid #ad742f;outline-offset:3px}.metadata{display:grid;grid-template-columns:1fr;gap:1rem;margin:2rem 0;max-width:38rem}.worksheet label{display:block;font-size:.92rem;font-weight:600;line-height:1.5}.worksheet input,.worksheet select,.worksheet textarea{display:block;box-sizing:border-box;width:100%;min-width:0;min-height:46px;margin:.4rem 0 0;padding:.7rem .75rem;font:inherit;font-size:1rem;font-weight:400;color:#173e35;background:#fffefa;border:1px solid #a7b7a5;border-radius:3px}.worksheet textarea{resize:vertical;line-height:1.6}.worksheet input[aria-invalid=true]{border:2px solid #986626}.worksheet input:disabled{opacity:.65}.notice{padding:1rem;border:1px solid #aa824c;background:#f5ead8;font-size:.93rem;line-height:1.6}.assumptions{margin-top:3rem;scroll-margin-top:1rem}.input-group{margin:2rem 0;border:1px solid #c4cebb;padding:1.25rem 1.4rem;background:#fffefa}.input-group h4{color:#235c48}.assumption-row{display:grid;grid-template-columns:minmax(0,1fr) minmax(130px,190px);gap:1.5rem;align-items:start;padding:1rem 0;border-top:1px solid #d1d6ca}.field-name{display:block;font-weight:650}.unit{display:block;font-size:.85rem;font-weight:400;color:#53665a;margin-top:.2rem}.help{display:block;font-size:.83rem;font-weight:400;color:#53665a;margin-top:.4rem;line-height:1.55;max-width:37rem}.value-cell input{margin-top:0;font-variant-numeric:tabular-nums}.field-error{display:block;color:#765121;font-size:.82rem;line-height:1.5;margin-top:.3rem}.part{padding-top:2rem;margin-top:3rem;border-top:2px solid #173e35;scroll-margin-top:1rem}.results{width:100%;border-collapse:collapse;table-layout:fixed;font-variant-numeric:tabular-nums}.results caption,.monthly-table caption{text-align:left;font-size:.85rem;color:#53665a;padding:1rem 0}.results th,.results td{text-align:left;vertical-align:top;padding:.85rem;border-bottom:1px solid #cbd4c4;line-height:1.45;font-size:1rem;overflow-wrap:anywhere}.results th{width:65%;font-weight:450}.results td{text-align:right}.results thead th{background:#173e35;color:#fffefa;font-weight:600}.results thead th:last-child{text-align:right;width:35%}.results tr:nth-child(even){background:#edf0e6}.results .emphasis th,.results .emphasis td{font-weight:700}.chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin:2rem 0}.chart-grid figure{margin:0;min-width:0}.chart-grid figcaption{font-weight:650;line-height:1.5;min-height:3rem}.chart-grid svg{display:block;width:100%;height:auto;background:#eef1e7;border:1px solid #cbd4c4}.monthly-scroll{overflow-x:auto;max-width:100%;overscroll-behavior-inline:contain}.monthly-table{width:2300px;table-layout:fixed;border-collapse:collapse;font-variant-numeric:tabular-nums}.monthly-table th,.monthly-table td{padding:.7rem .6rem;text-align:right;border-bottom:1px solid #cbd4c4;font-size:.86rem;line-height:1.4}.monthly-table th:first-child{width:65px;text-align:left}.monthly-table thead th{background:#173e35;color:#f7f5ee}.monthly-table tbody tr:nth-child(even){background:#edf0e6}.monthly-table tr[data-over-capacity=true]{background:#f5ead8;font-weight:700}.checks ul{padding-left:1.3rem;font-size:.93rem;line-height:1.7}.checks li{margin:.65rem 0}.review-section>label{margin:1rem 0}.save-status,.action-status{font-weight:600;font-size:.92rem}.saved-controls,.earlier-controls{padding:1.2rem;background:#edf0e6;margin:1.5rem 0}.saved-controls>*{margin:.65rem 0}.earlier-controls button{margin-top:1rem}.import-control{display:flex!important;align-items:flex-start;flex-direction:column;max-width:100%;overflow:hidden}.import-control input{border:0;padding:0;font-size:.85rem;min-height:30px;max-width:100%;background:transparent}.worksheet a{overflow-wrap:anywhere}.definitions{padding-bottom:1rem}
 .worksheet :global(.custom-row){border:1px solid #bdcbb7;background:#fffefa;padding:1.25rem;margin:1.25rem 0}.worksheet :global(.custom-row h4){font-size:1rem;margin:0 0 1rem}.worksheet :global(.custom-row label){display:block;margin:.8rem 0;font-size:.92rem;font-weight:600}.worksheet :global(.custom-row input),.worksheet :global(.custom-row select),.worksheet :global(.custom-row textarea){display:block;box-sizing:border-box;width:100%;min-width:0;min-height:46px;padding:.7rem .75rem;margin-top:.35rem;font:inherit;font-size:1rem;font-weight:400;border:1px solid #a7b7a5;border-radius:3px;background:#fffefa;color:#173e35}.worksheet :global(.custom-row textarea){min-height:70px}.worksheet :global(.custom-row button){min-height:46px;padding:.65rem .9rem;border:1px solid #a7b7a5;background:#fffefa;color:#173e35;border-radius:3px;cursor:pointer}.worksheet :global(.custom-row input[aria-invalid=true]){border:2px solid #986626}.worksheet :global(.custom-row input:disabled){background:#edf0e6}.worksheet :global(.custom-row [data-row-error]){font-size:.85rem;color:#765121;line-height:1.5}.worksheet :global(.custom-row :focus-visible){outline:3px solid #ad742f;outline-offset:3px}
 @media(max-width:640px){.worksheet{padding:2.5rem 0}.worksheet-shell{width:calc(100% - 28px)}.assumption-row{grid-template-columns:1fr;gap:.7rem}.input-group{padding:1rem}.value-cell{max-width:none}.metadata{max-width:none}.chart-grid{grid-template-columns:1fr}.results th{width:60%;padding:.8rem .6rem;font-size:.92rem}.results td{padding:.8rem .6rem;font-size:.92rem}.results thead th:last-child{width:40%}.actions>*{flex:1 1 160px}.worksheet :global(.custom-row){padding:1rem}.worksheet h2 br{display:none}}
 @media print{.actions,.saved-controls,.earlier-controls,.save-status,.worksheet button,.import-control{display:none!important}.worksheet-shell{width:100%}.input-group{break-inside:avoid}.results tr{break-inside:avoid}.monthly-scroll{overflow:visible}.monthly-table{width:100%;font-size:6pt}.monthly-table th,.monthly-table td{font-size:6pt;padding:2pt}.worksheet{padding:1rem 0}}
</style>
