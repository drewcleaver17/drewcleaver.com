---
import { filterInstitutions, institutionDomains, uapStatusLabels } from '../lib/ufo-institutions.mjs';
import { filterEvents, eventDateLabel, dateRoles, formatDate } from '../lib/ufos.mjs';
const { data } = Astro.props;
const institutions=filterInstitutions(data.entities);
const types=[...new Set(institutions.map(n=>n.institutionalProfile.entityType))].sort();
const chronology=filterEvents(data,{view:'institutions'});
const byId=new Map(data.events.map(e=>[e.id,e]));
const source=id=>data.sources[id];
---
<section id="institutions" class="institution-section" aria-labelledby="institutions-title">
  <div class="institution-heading"><div><p class="eyebrow">Who built the machinery?</p><h2 id="institutions-title">Institutions, in context.</h2></div><a class="underlined" href="?view=institutions#timeline" data-view="institutions">Read the institutional chronology →</a></div>
  <p class="section-intro">Agencies, military offices, research centers and surveillance programs are different kinds of institutions. Follow their origins and public record without assuming that a real organization verifies an alleged UAP role.</p>
  <div class="institution-orientation"><div><strong>Formation and disclosure are different dates.</strong><p>A charter, the start of operations, a public acknowledgment and a records release can be decades apart. “Not established” means this review did not verify the date.</p></div><div><strong>A center is not its operator.</strong><p>FFRDCs are federally funded research and development centers. Their government sponsors and operators have separate identities. UARC is a university research designation; GOCO describes government ownership and contractor operation. Check the cited period.</p></div></div>
  <form id="institution-filters" class="filter-panel" aria-label="Find an institution or acronym" role="search" hidden>
    <div class="filter-top"><label class="search-field">Find an acronym or institution<input name="iq" type="search" placeholder="Try NURO, MITRE, SOSUS…" autocomplete="off"/></label><label>Institution type<select name="itype"><option value="">All types</option>{types.map(t=><option>{t}</option>)}</select></label></div>
    <div class="institution-refine"><label>Domain<select name="idomain"><option value="">All domains</option>{Object.entries(institutionDomains).map(([value,label])=><option value={value}>{label}</option>)}</select></label><label>Research designation<select name="idesignation"><option value="">All arrangements</option>{['FFRDC','UARC','GOCO','GOGO','FFRDC operator'].map(value=><option>{value}</option>)}</select></label><label>UAP relationship<select name="iuap"><option value="">All evidence boundaries</option>{Object.entries(uapStatusLabels).map(([value,label])=><option value={value}>{label}</option>)}</select></label><button type="reset">Clear institution filters</button></div>
    <p id="institution-count" role="status" aria-live="polite">{institutions.length} institutional dossiers</p>
  </form>
  <p id="institution-link-status" class="link-status" role="status" aria-live="polite"></p><button id="reveal-institution" class="underlined" type="button" hidden>Reveal the linked institution</button>
  <p class="search-scope">The dossiers below identify what the inspected sources support. An institution can matter to this history without a demonstrated UAP role. Search covers names, acronyms, aliases and dossier text; it does not search complete archival documents.</p>
  <div id="institution-results" class="institution-grid">
    {institutions.map(n=>{
      const p=n.institutionalProfile, milestones=p.milestoneIds.map(id=>byId.get(id)).filter(Boolean).sort((a,b)=>a.date.start.localeCompare(b.date.start));
      const relationships=data.relationships.filter(r=>r.from===n.id||r.to===n.id);
      return <details id={`entity-${n.id}`} class="institution-card" data-institution={n.id} tabindex="-1">
        <summary><span class="institution-kicker">{p.acronym || institutionDomains[p.domain]} · {p.entityType}</span><strong>{n.name}</strong><span class="institution-boundary">{uapStatusLabels[p.uapStatus]}</span></summary>
        <div class="institution-body">
          {n.aliases.length>0 && <p class="entity-aliases">Also indexed: {n.aliases.join(' · ')}</p>}
          <p class="entity-aliases">Institutional identity: {p.classificationNote}.</p>
          {p.attributes.length>0 && <p class="institution-attributes">Research / operating designations: {p.attributes.join(' · ')}. Dates and organizational scope follow the sources below.</p>}
          {p.attributePeriods?.length>0 && <p class="institution-attributes">Designation snapshots: {p.attributePeriods.map(x=>`${x.attribute} — ${formatDate(x.asOf)}`).join(' · ')}. These are source snapshots, not inferred designation start dates.</p>}
          {p.rosterRecord && <dl class="institution-roster"><div><dt>Displayed government sponsor · {formatDate(p.rosterRecord.asOf)}</dt><dd>{p.rosterRecord.sponsor}{p.rosterRecord.subAgency && ` / ${p.rosterRecord.subAgency}`}</dd></div><div><dt>{p.attributes.includes('UARC') ? 'University affiliation in that roster' : 'Administrator / operator in that roster'}</dt><dd>{p.rosterRecord.administrator}</dd></div>{p.rosterRecord.additionalSponsors?.length>0 && <div><dt>Additional sponsors</dt><dd>{p.rosterRecord.additionalSponsors.join(' · ')}</dd></div>}{p.rosterRecord.dateBasis && <div><dt>Snapshot scope</dt><dd>{p.rosterRecord.dateBasis}</dd></div>}</dl>}
          <p><strong>Mission and identity.</strong> {p.mission}</p>
          <p><strong>Why it belongs here.</strong> {p.relevance}</p>
          <div class="institution-evidence"><strong>{uapStatusLabels[p.uapStatus]}</strong><p>{p.uapNote}</p></div>
          {milestones.length>0 ? <div class="institution-dates"><h3>Dates in the public record</h3><ol>{milestones.map(e=><li><span>{eventDateLabel(e)} · {dateRoles[e.date.role]}</span><a href={`#${e.id}`}>{e.title}</a></li>)}</ol></div> : <p><strong>Formation / acknowledgment dates:</strong> not established by the inspected sources in this review. No date has been invented to place this dossier in the chronology.</p>}
          {p.questions.length>0 && <details class="institution-questions"><summary>Limits & open records</summary><ul>{p.questions.map(q=><li>{q}</li>)}</ul></details>}
          {relationships.length>0 && <div class="institution-relations"><h3>Source-scoped relationships</h3>{relationships.map(r=><p><a href={`#relation-${r.id}`}>{r.status} · {r.type.replaceAll('-',' ')} · {formatDate(r.date.start)}{r.date.end && ` – ${formatDate(r.date.end)}`}</a><br/>{r.description}</p>)}</div>}
          <div class="institution-sources"><h3>Source scope</h3>{p.sourceIds.map(id=><p><a href={source(id).url} target="_blank" rel="noopener noreferrer">{source(id).title} ↗</a><span>{source(id).publisher} · {source(id).locator}</span><span>{data.sourceReviews[id]?.scope || source(id).note}</span></p>)}</div>
          {n.eventIds.length>0 && <a class="underlined" href={`?view=history&entity=${encodeURIComponent(n.id)}#timeline`}>Read all related timeline entries →</a>}
        </div>
      </details>;
    })}
  </div>
  <p id="institution-empty" class="empty-state" hidden>No institutional dossiers match these filters. Try a full name, another acronym, or clear the filters.</p>
  <details class="editorial-detail" id="institution-date-table"><summary>Formation, transition & disclosure dates <span>{chronology.length} dated records · dates retain their meaning</span></summary><div class="institution-table-wrap" role="region" aria-label="Institutional chronology table" tabindex="0"><table class="institution-table"><thead><tr><th scope="col">Date</th><th scope="col">Date describes</th><th scope="col">Milestone</th></tr></thead><tbody>{chronology.map(e=><tr><td>{eventDateLabel(e)}</td><td>{dateRoles[e.date.role]}</td><td><a href={`#${e.id}`}>{e.title}</a></td></tr>)}</tbody></table></div></details>
</section>
