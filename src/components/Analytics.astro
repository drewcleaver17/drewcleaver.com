---
import { integrations } from '../config/integrations';
---
<section id="analytics-choice" class="analytics-choice" aria-labelledby="analytics-choice-title" data-measurement-id={integrations.googleAnalyticsId} hidden>
  <h2 id="analytics-choice-title">Help me improve this site?</h2>
  <p>Optional Google Analytics measures visits and useful link clicks. It doesn’t receive what you type into forms. <a href="/privacy/">Privacy details</a></p>
  <div class="analytics-choice-actions">
    <button class="button button-outline" type="button" data-analytics-choice="denied">No thanks</button>
    <button class="button button-outline" type="button" data-analytics-choice="granted">Allow analytics</button>
  </div>
</section>
<script>import '../scripts/analytics';</script>
