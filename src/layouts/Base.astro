---
import '../styles/global.css';
import { profile } from '../data/profile';
import Analytics from '../components/Analytics.astro';
import { analyticsEnabled, integrations, publicPages } from '../config/integrations';
interface Props { title: string; description?: string; compact?: boolean; noindex?: boolean; }
const { title, description = profile.description, compact = false, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, profile.website);
const links = [{ href: '/about/', label: 'About' }, { href: '/services/', label: 'Work with me' }, { href: profile.bookingUrl, label: 'Schedule a conversation' }];
const active = (href: string) => Astro.url.pathname.replace(/\/$/, '') === href.replace(/\/$/, '');
const measurePage = analyticsEnabled && !noindex && publicPages.includes(Astro.url.pathname);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173e35" />
    <title>{title === 'Home' ? `${profile.name} — Founder, inventor & curious person` : `${title} — ${profile.name}`}</title>
    <meta name="description" content={description} />
    {integrations.googleSiteVerification && Astro.url.pathname === '/' && <meta name="google-site-verification" content={integrations.googleSiteVerification} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title === 'Home' ? profile.name : `${title} — ${profile.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class:list={['site-body', { 'compact-page': compact }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/" aria-label={`${profile.name} home`}>{profile.name}<span aria-hidden="true">.</span></a>
        {compact ? <a class="quiet-link" href="/">Explore my site <span aria-hidden="true">↗</span></a> : <>
          <nav class="desktop-nav" aria-label="Main navigation">
            {links.map(({ href, label }) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
            <a class="nav-contact" href="/contact/" aria-current={active('/contact/') ? 'page' : undefined}>Say hello</a>
            <a href="/hello/" aria-current={active('/hello/') ? 'page' : undefined}>Linktree</a>
          </nav>
          <details class="mobile-menu">
            <summary>Menu <span aria-hidden="true">+</span></summary>
            <nav aria-label="Mobile navigation">
              {links.map(({ href, label }) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
              <a href="/contact/" aria-current={active('/contact/') ? 'page' : undefined}>Say hello</a>
              <a href="/hello/" aria-current={active('/hello/') ? 'page' : undefined}>Linktree</a>
            </nav>
          </details>
        </>}
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>© {new Date().getFullYear()} {profile.name}<span class="footer-location">{profile.location}</span></p>
        <div><a href="/hello/">Save my contact</a><a href={profile.resumeFile} download="Drew-Cleaver-Resume.pdf">Résumé (PDF)</a><a href={`mailto:${profile.email}`}>Email me <span aria-hidden="true">↗</span></a><a href="/privacy/">Privacy</a>{measurePage && <button type="button" id="analytics-settings" hidden>Analytics preferences</button>}</div>
      </div>
    </footer>
    {measurePage && <Analytics />}
  </body>
</html>
